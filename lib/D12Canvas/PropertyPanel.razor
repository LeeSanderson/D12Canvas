@namespace D12Canvas

@using D12Canvas.Panel

<CascadingValue Value="D12IconStyles.InScope" IsFixed="true">
<div class="d12-property-panel" role="region" aria-label="Property panel" @ref="_panelElement">
    @if (SelectedInstances.Count == 0)
    {
        <p class="d12-property-panel-empty">No selection</p>
    }
    else
    {
        @if (AllLocked)
        {
            <button type="button" class="d12-property-panel-unlock" @onclick="Unlock">Unlock</button>
        }
        else if (Locks.IsPartial)
        {
            <p class="d12-property-panel-locks"><D12Icon Glyph="Glyphs.Lock" /><span>@Locks.Summary</span></p>
        }
        <ul class="d12-property-panel-fields">
            @foreach (var field in Fields)
            {
                <li class="d12-property-panel-field" @key="RowKey(field)">
                    @if (field.DrawsTiles)
                    {
                        <div class="d12-property-panel-label">
                            <span id="@field.LabelId">@field.Label</span>
                            @if (field.IsMixed)
                            {
                                <span class="d12-property-panel-mixed-tag">@MixedValue.Label</span>
                            }
                        </div>
                        @TilesMarkup(field)
                    }
                    else
                    {
                    <label class="d12-property-panel-label" for="@field.FieldId">@field.Label</label>
                    @switch (field.Kind)
                    {
                        case EditorKind.Text:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-input"
                                type="text"
                                value="@CurrentValue(field)"
                                placeholder="@MixedPlaceholder(field)"
                                disabled="@AllLocked"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Number:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-input"
                                type="number"
                                value="@CurrentValue(field)"
                                placeholder="@MixedPlaceholder(field)"
                                disabled="@AllLocked"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Color:
                            <div class="d12-property-panel-color-row">
                                <input
                                    id="@field.FieldId"
                                    class="@ColorInputClass(field)"
                                    type="color"
                                    value="@ColorValue(field)"
                                    disabled="@AllLocked"
                                    @oninput="@(e => HoldPick(field, e))"
                                    @onchange="@(e => CommitPick(field, e))"
                                    @onblur="@(() => CommitHeldPick(field))"
                                />
                                @if (field.IsMixed)
                                {
                                    <span class="d12-property-panel-mixed-label">@MixedValue.Label</span>
                                }
                                @if (field.CanHoldNull)
                                {
                                    if (IsThemed(field))
                                    {
                                        <span class="d12-property-panel-themed-label">Theme colour</span>
                                    }
                                    else
                                    {
                                        <button
                                            type="button"
                                            class="d12-property-panel-clear"
                                            aria-label="Use theme colour"
                                            disabled="@AllLocked"
                                            @onclick="@(() => Commit(field, null))"
                                        >
                                            Use theme colour
                                        </button>
                                    }
                                }
                            </div>
                            break;
                        case EditorKind.Checkbox:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-checkbox"
                                type="checkbox"
                                checked="@CurrentBoolValue(field)"
                                disabled="@AllLocked"
                                @ref="_checkboxes[field.FieldId]"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Dropdown:
                            <select
                                id="@field.FieldId"
                                class="d12-property-panel-input"
                                value="@CurrentValue(field)"
                                disabled="@AllLocked"
                                @onchange="@(e => CommitEdit(field, e))"
                            >
                                @if (field.IsMixed)
                                {
                                    <option value="" disabled selected>@MixedValue.Label</option>
                                }
                                @foreach (var option in field.Options!)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                            break;
                        case EditorKind.Custom:
                            <div id="@field.FieldId" class="d12-property-panel-custom">
                                @field.CustomEditor!(CustomContext(field))
                            </div>
                            break;
                    }
                    }
                </li>
            }
        </ul>
    }
</div>
</CascadingValue>

<style>
    @(D12IconStyles.Rules)
    @(RaisedSurface.TokenRules(".d12-property-panel"))
    @(PinnedChrome.Text(".d12-property-panel", 16))
    @(PinnedChrome.Button(".d12-property-panel-clear, .d12-property-panel-unlock, .d12-property-panel-tile"))
    .d12-property-panel {
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        padding: 12px;
        box-sizing: border-box;
        color: var(--d12-text);
    }

    .d12-property-panel-empty {
        margin: 0;
        font-size: 13px;
        color: var(--d12-muted-text);
    }

    .d12-property-panel-locks {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        font-size: 12px;
        color: var(--d12-muted-text);
    }

    .d12-property-panel-locks .d12-icon {
        flex: none;
    }

    .d12-property-panel-fields {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .d12-property-panel-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .d12-property-panel-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--d12-muted-text);
    }

    .d12-property-panel-input {
        font: inherit;
        margin: 0;
        padding: 4px 6px;
        border: 1px solid var(--d12-border);
        border-radius: 4px;
        box-sizing: border-box;
        background: var(--d12-surface);
        color: inherit;
    }

    .d12-property-panel-input::-webkit-inner-spin-button {
        height: auto;
    }

    .d12-property-panel-color {
        padding: 2px;
        height: 28px;
    }

    .d12-property-panel-color::-webkit-color-swatch-wrapper {
        padding: 0;
    }

    .d12-property-panel-color-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .d12-property-panel-color-themed::-webkit-color-swatch {
        background: var(--d12-surface);
        border: 1px dashed var(--d12-muted-text);
    }

    .d12-property-panel-color-themed::-moz-color-swatch {
        background: var(--d12-surface);
        border: 1px dashed var(--d12-muted-text);
    }

    .d12-property-panel-color-mixed::-webkit-color-swatch {
        background: repeating-linear-gradient(
            45deg,
            var(--d12-muted-text) 0 2px,
            var(--d12-surface) 2px 6px
        );
        border: 1px solid var(--d12-muted-text);
    }

    .d12-property-panel-color-mixed::-moz-color-swatch {
        background: repeating-linear-gradient(
            45deg,
            var(--d12-muted-text) 0 2px,
            var(--d12-surface) 2px 6px
        );
        border: 1px solid var(--d12-muted-text);
    }

    .d12-property-panel-themed-label,
    .d12-property-panel-mixed-label {
        font-size: 12px;
        color: var(--d12-muted-text);
    }

    .d12-property-panel-clear,
    .d12-property-panel-unlock {
        font-size: 12px;
        box-sizing: border-box;
        padding: 2px 6px;
        border: 1px solid var(--d12-border);
        border-radius: 4px;
        background: transparent;
        cursor: pointer;
    }

    .d12-property-panel-fields :disabled {
        opacity: 0.5;
        cursor: default;
    }

    .d12-property-panel-checkbox {
        margin: 0;
        width: 16px;
        height: 16px;
        align-self: flex-start;
    }

    .d12-property-panel-custom {
        display: flex;
    }

    .d12-property-panel-mixed-tag {
        margin-left: 6px;
        font-weight: 400;
        font-style: italic;
    }

    .d12-property-panel-tiles {
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(
                min(max(52px, calc(var(--d12-tile-name-length) * 1.2ch + 12px)), calc(50% - 1px)),
                1fr
            )
        );
        gap: 2px;
        padding: 2px;
        border: 1px solid var(--d12-border);
        border-radius: 5px;
        background: color-mix(in srgb, var(--d12-border) 20%, var(--d12-surface));
        font-size: 10px;
    }

    .d12-property-panel-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        min-width: 0;
        height: 42px;
        padding: 0;
        border: 0;
        border-radius: 3px;
        background: transparent;
        font-size: 10px;
        cursor: pointer;
    }

    .d12-property-panel-tile:hover:not(:disabled) {
        background: color-mix(in srgb, var(--d12-border) 45%, var(--d12-surface));
    }

    .d12-property-panel-tile:focus-visible {
        outline: 2px solid var(--d12-accent);
        outline-offset: -2px;
    }

    .d12-property-panel-tile[aria-checked="true"] {
        background: var(--d12-surface);
        color: var(--d12-accent);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--d12-accent) 50%, transparent);
    }

    .d12-property-panel-tile-name {
        max-width: 100%;
        padding: 0 2px;
        box-sizing: border-box;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.2;
    }
</style>

@code {
    private RenderFragment TilesMarkup(PanelField field) =>
        @<div
            id="@field.FieldId"
            class="d12-property-panel-tiles"
            role="radiogroup"
            aria-labelledby="@field.LabelId"
            style="--d12-tile-name-length: @field.LongestOptionNameLength"
            @onfocusout="() => TilesLostFocus(field)"
        >
            @{
                var checkedIndex = CheckedTileIndex(field);
                var tabStopIndex = TabStopTileIndex(field);
            }
            @for (var index = 0; index < field.Options!.Count; index++)
            {
                var tileIndex = index;
                var option = field.Options[tileIndex];
                <button
                    type="button"
                    role="radio"
                    class="d12-property-panel-tile"
                    aria-checked="@(tileIndex == checkedIndex ? "true" : "false")"
                    tabindex="@(!AllLocked && tileIndex == tabStopIndex ? "0" : "-1")"
                    disabled="@AllLocked"
                    @key="option"
                    @ref="_tileElements[(field.FieldId, tileIndex)]"
                    @onfocus="() => TileFocused(field, tileIndex)"
                    @onkeydown="args => HandleTileKeyDown(field, tileIndex, args)"
                    @onclick="() => Commit(field, option)"
                >
                    <D12Icon Glyph="field.OptionGlyphs![option]" />
                    <span class="d12-property-panel-tile-name">@OptionName.For(option)</span>
                </button>
            }
        </div>;
}

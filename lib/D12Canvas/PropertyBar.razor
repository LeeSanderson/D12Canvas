@namespace D12Canvas
@using D12Canvas.Model
@using D12Canvas.Panel

<div class="d12-property-bar" role="toolbar" aria-label="Selection properties" style="@BarStyle" @ref="_barRef">
    <svg class="d12-property-bar-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <pattern id="d12-property-bar-hatch" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <rect class="d12-property-bar-hatch-ground" width="3" height="3" />
                <rect class="d12-property-bar-hatch-line" width="1.2" height="3" />
            </pattern>
        </defs>
    </svg>
    @foreach (var row in Rows)
    {
        switch (row.Kind)
        {
            case EditorKind.Color:
                <div class="@ColourCellClass(row)" style="@AccentStyle(row)" @key="RowKey(row)">
                    <D12Icon Glyph="RoleGlyph(row.Role)" />
                    <span class="d12-property-bar-value">@ChipValue(row)</span>
                    <D12Icon Glyph="Glyphs.Caret" Class="d12-property-bar-caret" />
                    <input class="d12-property-bar-control d12-property-bar-overlay"
                           type="color"
                           tabindex="-1"
                           aria-label="@ChipName(row)"
                           value="@ColorValue(row)"
                           @oninput="@(e => HoldPick(row, e))"
                           @onchange="@(e => CommitPick(row, e))"
                           @onblur="@(() => CommitHeldPick(row))" />
                    @if (row.CanHoldNull && !row.IsThemed)
                    {
                        <button type="button"
                                class="d12-property-bar-use-theme"
                                hidden
                                tabindex="-1"
                                @onclick="@(() => UseThemeColour(row))"></button>
                    }
                </div>
                break;
            case EditorKind.Dropdown:
                <div class="d12-property-bar-cell d12-property-bar-chip-cell" @key="row.Id">
                    <button type="button"
                            class="@ChoiceChipClass(row)"
                            tabindex="-1"
                            aria-haspopup="menu"
                            aria-expanded="@(IsOpen(row) ? "true" : "false")"
                            aria-label="@ChipName(row)"
                            @ref="_chipElements[row.Id]"
                            @onclick="@(() => ToggleFlyout(row))">
                        @if (CurrentOptionGlyph(row) is { } glyph)
                        {
                            <D12Icon Glyph="glyph" />
                        }
                        <span class="d12-property-bar-value">@ChipValue(row)</span>
                        <D12Icon Glyph="Glyphs.Caret" Class="d12-property-bar-caret" />
                    </button>
                    @if (IsOpen(row) && _chipElements.TryGetValue(row.Id, out var opener))
                    {
                        @Flyout.Around(row.Label, "d12-property-bar-flyout", opener, EventCallback.Factory.Create(this, CloseFlyout), OptionsMarkup(row))
                    }
                </div>
                break;
            case EditorKind.Number:
                <div class="d12-property-bar-cell d12-property-bar-cell-number" @key="RowKey(row)">
                    @Tooltip.Around(NumberName(row), TooltipSide.Above, NumberMarkup(row))
                </div>
                break;
        }
    }
</div>

<style>
    @(RaisedSurface.TokenRules(".d12-property-bar"))
    @(PinnedChrome.Text(".d12-property-bar", 12))
    @(PinnedChrome.Button(".d12-property-bar-chip"))
    @(Tooltip.Rules)
    @(Flyout.Rules)
    .d12-property-bar {
        position: absolute;
        z-index: 900;
        display: flex;
        align-items: center;
        gap: 2px;
        height: 34px;
        padding: 3px;
        box-sizing: border-box;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        box-shadow: 0 2px 8px var(--d12-shadow);
        color: var(--d12-text);
        white-space: nowrap;
        --d12-tooltip-offset: 12px;
    }

    @@media (prefers-reduced-motion: reduce) {
        .d12-property-bar {
            transition-duration: 0s !important;
        }
    }

    .d12-property-bar.d12-property-bar-settling:not(:hover, :focus-within) {
        visibility: hidden;
    }

    .diagram-container:has(.d12-property-bar:hover, .d12-property-bar:focus-within) {
        & .selection-bounding-box,
        & .resize-handle,
        & .resize-span,
        & .port-span,
        & .port,
        & .custom-port,
        & .edge-halo {
            visibility: hidden;
        }

        & .component-container.selected {
            outline-color: transparent;
        }
    }

    .d12-property-bar-defs {
        position: absolute;
        width: 0;
        height: 0;
    }

    .d12-property-bar-hatch-ground {
        fill: var(--d12-surface);
    }

    .d12-property-bar-hatch-line {
        fill: var(--d12-muted-text);
    }

    .d12-property-bar-cell {
        position: relative;
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 4px;
        height: 26px;
        box-sizing: border-box;
        border-radius: 4px;
        color: var(--d12-text);
    }

    .d12-property-bar-colour,
    .d12-property-bar-chip {
        padding: 0 4px 0 6px;
    }

    .d12-property-bar-colour:hover,
    .d12-property-bar-chip:hover,
    .d12-property-bar-chip[aria-expanded=true] {
        background: color-mix(in srgb, var(--d12-border) 35%, var(--d12-surface));
    }

    .d12-property-bar-colour:focus-within,
    .d12-property-bar-cell-number:focus-within {
        outline: 2px solid var(--d12-accent);
        outline-offset: -2px;
    }

    .d12-property-bar-chip {
        display: flex;
        align-items: center;
        gap: 4px;
        height: 26px;
        border: 0;
        border-radius: 4px;
        background: transparent;
        cursor: pointer;
    }

    .d12-property-bar-chip:focus {
        outline: none;
    }

    .d12-property-bar-chip:focus-visible {
        outline: 2px solid var(--d12-accent);
        outline-offset: -2px;
    }

    .d12-property-bar-value {
        pointer-events: none;
    }

    .d12-property-bar-colour-mixed .d12-property-bar-value,
    .d12-property-bar-colour-themed .d12-property-bar-value,
    .d12-property-bar-chip-mixed .d12-property-bar-value {
        color: var(--d12-muted-text);
    }

    .d12-property-bar-caret {
        --d12-icon-size: 12px;
        color: var(--d12-muted-text);
    }

    .d12-property-bar .d12-icon {
        pointer-events: none;
    }

    .d12-property-bar-colour-themed .d12-icon .d12-icon-accent {
        stroke: var(--d12-muted-text);
        stroke-dasharray: 2 1.5;
    }

    .d12-property-bar-colour-themed .d12-icon .d12-icon-accent.d12-icon-fill {
        fill: none;
        stroke-width: 1;
    }

    .d12-property-bar-colour-mixed .d12-icon .d12-icon-accent {
        stroke: url(#d12-property-bar-hatch);
    }

    .d12-property-bar-colour-mixed .d12-icon .d12-icon-accent.d12-icon-fill {
        fill: url(#d12-property-bar-hatch);
        stroke: var(--d12-muted-text);
        stroke-width: 0.6;
    }

    .d12-property-bar-cell-number {
        padding-left: 5px;
    }

    .d12-property-bar-cell-number .d12-tooltip-anchor {
        align-items: center;
        gap: 2px;
    }

    .d12-property-bar-overlay {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        border: 0;
        font: inherit;
        opacity: 0;
        cursor: pointer;
    }

    .d12-property-bar-number {
        width: 40px;
        height: 22px;
        box-sizing: border-box;
        margin: 0;
        padding: 0 2px;
        font: inherit;
        border: 1px solid var(--d12-border);
        border-radius: 3px;
        background: var(--d12-surface);
        color: inherit;
    }

    .d12-property-bar-number::-webkit-inner-spin-button {
        height: auto;
    }

    .d12-property-bar-number:focus {
        outline: none;
    }

    .d12-property-bar-flyout {
        top: calc(100% + 8px);
        left: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 140px;
        padding: 6px;
    }

    .d12-property-bar-flyout .d12-flyout-heading {
        margin: 2px 0 4px 8px;
        font-size: 10px;
    }

    .d12-property-bar-flyout-item[aria-checked=true] {
        color: var(--d12-accent);
        font-weight: 600;
    }

    .d12-property-bar-flyout-gap {
        width: var(--d12-icon-size);
        flex: none;
    }
</style>

@code {
    private RenderFragment NumberMarkup(PropertyBarRow row) =>
        @<text>
            <D12Icon Glyph="RoleGlyph(row.Role)" />
            <input class="d12-property-bar-control d12-property-bar-number"
                   type="number"
                   min="0"
                   tabindex="-1"
                   aria-label="@NumberName(row)"
                   value="@TextValue(row)"
                   placeholder="@(row.IsMixed ? MixedNumberPlaceholder : null)"
                   @onchange="@(e => Commit(row, e))" />
        </text>;

    private RenderFragment OptionsMarkup(PropertyBarRow row) =>
        @<text>
            <div class="d12-flyout-heading" aria-hidden="true">@row.Label</div>
            @foreach (var option in row.Options ?? [])
            {
                var picked = option;
                <button type="button"
                        role="menuitemradio"
                        class="d12-flyout-item d12-property-bar-flyout-item"
                        aria-checked="@(IsCurrent(row, option) ? "true" : "false")"
                        tabindex="-1"
                        @onclick="@(() => PickOption(row, picked))">
                    @if (row.OptionGlyphs?.GetValueOrDefault(option) is { } glyph)
                    {
                        <D12Icon Glyph="glyph" />
                    }
                    else
                    {
                        <span class="d12-property-bar-flyout-gap"></span>
                    }
                    <span>@OptionName.For(option)</span>
                </button>
            }
        </text>;
}

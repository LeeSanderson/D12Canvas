@namespace D12Canvas

<svg viewBox="0 0 16 16"
     class="@SvgClass"
     fill="none"
     stroke="currentColor"
     stroke-linecap="round"
     stroke-linejoin="round"
     role="@(Label is null ? null : "img")"
     aria-label="@Label"
     aria-hidden="@(Label is null ? "true" : null)"
     focusable="false"
     @attributes="AdditionalAttributes">
    @foreach (var part in Glyph.Parts)
    {
        <path d="@part.Data" class="@PartClass(part.Paint)" fill-rule="@(IsFill(part.Paint) ? "evenodd" : null)" />
    }
</svg>

@if (StylesInScope is null)
{
    <style>
        @(D12IconStyles.Rules)
    </style>
}

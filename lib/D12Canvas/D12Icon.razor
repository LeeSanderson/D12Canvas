@namespace D12Canvas

<svg viewBox="0 0 16 16"
     class="@SvgClass"
     fill="none"
     stroke="currentColor"
     stroke-linecap="round"
     stroke-linejoin="round"
     role="@(Label is null ? null : "img")"
     aria-label="@Label"
     aria-hidden="@(Label is null ? "true" : null)"
     focusable="false"
     @attributes="AdditionalAttributes">
    @foreach (var part in Glyph.Parts)
    {
        <path d="@part.Data" class="@PartClass(part.Paint)" fill-rule="@(IsFill(part.Paint) ? "evenodd" : null)" />
    }
</svg>

<style>
    .d12-icon {
        width: var(--d12-icon-size, 16px);
        height: var(--d12-icon-size, 16px);
        flex: none;
        stroke-width: var(--d12-icon-stroke, 1.5);
    }

    .d12-icon .d12-icon-fill {
        fill: currentColor;
        stroke: none;
    }

    .d12-icon .d12-icon-accent {
        stroke: var(--d12-icon-accent, currentColor);
    }

    .d12-icon .d12-icon-accent.d12-icon-fill {
        fill: var(--d12-icon-accent, currentColor);
        stroke: none;
    }
</style>

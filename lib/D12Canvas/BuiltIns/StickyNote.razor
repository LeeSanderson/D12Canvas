@namespace D12Canvas.BuiltIns
@implements IInlineEditable
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="d12-sticky-note" style="@Style">
    @if (_isEditing)
    {
        <textarea class="d12-sticky-note-text d12-sticky-note-editor"
                  style="@TextStyle"
                  @ref="_editorRef"
                  @bind="_editBuffer" @bind:event="oninput"
                  @onblur="HandleEditorBlur"
                  @onkeydown="HandleEditorKeyDown" @onkeydown:stopPropagation></textarea>
    }
    else
    {
        <p class="d12-sticky-note-text" style="@TextStyle">@Props.Text</p>
    }
</div>

<style>
    .d12-sticky-note {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        padding: 10px;
    }

    .d12-sticky-note-text {
        display: block;
        flex: none;
        width: 100%;
        margin: 0;
        box-sizing: border-box;
        white-space: pre-wrap;
        overflow-wrap: break-word;
    }

    .d12-sticky-note-editor {
        field-sizing: content;
        overflow: hidden;
        font: inherit;
        border: none;
        outline: 1px dashed var(--d12-inline-edit-outline);
        resize: none;
        background: transparent;
        padding: 0;
    }
</style>

@code {
    [Parameter]
    public StickyNoteProps Props { get; set; } = new("", "#FFEB3B", "#000000", 14);

    [CascadingParameter(Name = "ParentCanvas")]
    private DiagramCanvas? ParentCanvas { get; set; }

    [CascadingParameter(Name = "InstanceId")]
    private Guid InstanceId { get; set; }

    private bool _isEditing;
    private bool _focusPending;
    private string _editBuffer = "";
    private ElementReference _editorRef;

    private string Style =>
        InlineStyleValue.Join(
            InlineStyleValue.Declaration("background-color", Props.Color),
            $"justify-content: {JustifyContent};"
        );

    private string TextStyle =>
        InlineStyleValue.Join(
            InlineStyleValue.Declaration("color", Props.TextColor),
            $"font-size: {Props.FontSize}px;",
            InlineStyleValue.Declaration("text-align", Props.TextAlign)
        );

    // Safe alignment keeps the first line of text taller than the note at its top edge.
    private string JustifyContent =>
        Props.VerticalAlign switch
        {
            "top" => "flex-start",
            "bottom" => "safe flex-end",
            _ => "safe center",
        };

    public void BeginEdit()
    {
        _editBuffer = Props.Text;
        _isEditing = true;
        _focusPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // BeginEdit can arrive while this component's after-render from an earlier render in the
        // same batch is still to run, before the editor itself has rendered.
        if (_focusPending && _editorRef.Id is not null)
        {
            _focusPending = false;
            await InlineEditorEntry.FocusAndSelectAllAsync(JS, _editorRef);
        }
    }

    private void HandleEditorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            EndEdit(returnFocus: true);
        }
    }

    private void HandleEditorBlur() => EndEdit(returnFocus: false);

    // Escape removes the editor from the DOM, and the browser may then fire a blur for it, which
    // must not end the same edit a second time.
    private void EndEdit(bool returnFocus)
    {
        if (!_isEditing)
        {
            return;
        }

        _isEditing = false;
        _editorRef = default;
        ParentCanvas?.CommitInlineEdit(
            InstanceId,
            Props,
            Props with { Text = _editBuffer },
            returnFocus
        );
    }
}

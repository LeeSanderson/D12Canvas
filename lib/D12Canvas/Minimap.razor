@namespace D12Canvas

<div class="d12-minimap" aria-hidden="true" @ref="_root">
    @if (Shown)
    {
        <div class="d12-minimap-content" style="@ContentStyle">
            <MinimapBoxes Board="Board" Revision="_revision" />
        </div>
        <div class="d12-minimap-viewport" style="@ViewportStyle"></div>
    }
</div>

<style>
    @(RaisedSurface.TokenRules(".d12-minimap"))
    .d12-minimap {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        box-sizing: border-box;
        background: var(--d12-surface);
        box-shadow: inset 0 0 0 1px var(--d12-border);
        border-radius: 6px;
        color: var(--d12-text);
        cursor: pointer;
        user-select: none;
    }

    .d12-minimap-content {
        position: absolute;
        left: 0;
        top: 0;
        transform-origin: 0 0;
        pointer-events: none;
    }

    .d12-minimap-box {
        position: absolute;
        background: color-mix(in srgb, var(--d12-muted-text) 45%, var(--d12-surface));
    }

    .d12-minimap-viewport {
        position: absolute;
        box-sizing: border-box;
        border: 2px solid var(--d12-accent);
        background: color-mix(in srgb, var(--d12-accent) 10%, transparent);
        pointer-events: none;
    }
</style>

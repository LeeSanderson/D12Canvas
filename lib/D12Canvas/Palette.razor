@namespace D12Canvas

<CascadingValue Value="D12IconStyles.InScope" IsFixed="true">
    <div class="d12-palette" role="toolbar" aria-orientation="vertical" aria-label="Component palette" @ref="_railElement" @onkeydown="HandleKeyDown">
        @{
            var buttons = RailButtons();
            var overflowCount = OverflowCount();
            var activeIndex = Math.Clamp(_activeIndex, 0, RailStopCount() - 1);
        }
        @for (var index = 0; index < buttons.Count; index++)
        {
            var buttonIndex = index;
            var button = buttons[buttonIndex];
            if (button.StartsGroup && buttonIndex > 0)
            {
                <div class="d12-palette-divider" role="separator"></div>
            }
            @Tooltip.Around(button.DisplayName, TooltipSide.Right, RailButtonMarkup(button, buttonIndex, buttonIndex == activeIndex))
        }
        @if (overflowCount > 0)
        {
            var moreIndex = buttons.Count;
            <div class="d12-palette-divider" role="separator"></div>
            <div class="@(_flyoutOpen ? "d12-palette-more d12-palette-more-open" : "d12-palette-more")">
                @Tooltip.Around($"{MoreName} ({overflowCount})", TooltipSide.Right, MoreButtonMarkup(moreIndex, moreIndex == activeIndex))
                @if (_flyoutOpen && _buttonElements.TryGetValue(moreIndex, out var opener))
                {
                    @Flyout.Around(MoreName, "d12-palette-flyout", opener, EventCallback.Factory.Create(this, CloseFlyout), OverflowMarkup)
                }
            </div>
        }
    </div>
</CascadingValue>

<style>
    @(RaisedSurface.TokenRules(".d12-palette"))
    @(PinnedChrome.Text(".d12-palette", 16))
    @(PinnedChrome.Button(".d12-palette-button"))
    @(D12IconStyles.Rules)
    @(Tooltip.Rules)
    @(Flyout.Rules)
    .d12-palette {
        --d12-icon-size: 18px;
        --d12-tooltip-offset: 17px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        width: max-content;
        padding: 4px;
        box-sizing: border-box;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        color: var(--d12-text);
    }

    .d12-palette-button {
        width: 36px;
        height: 36px;
        flex: none;
        display: grid;
        place-items: center;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        cursor: pointer;
    }

    .d12-palette-button:hover {
        background: @(RaisedSurface.HoverBackground);
    }

    .d12-palette-more-open .d12-palette-button {
        background: @(RaisedSurface.HoverBackground);
    }

    .d12-palette-button:focus-visible {
        outline: 2px solid var(--d12-accent);
        outline-offset: -2px;
    }

    .d12-palette-divider {
        width: 24px;
        height: 1px;
        flex: none;
        margin: 4px 0;
        background: var(--d12-border);
    }

    .d12-palette-more {
        position: relative;
        display: flex;
    }

    .d12-palette-more-open .d12-tooltip-anchor > .d12-tooltip {
        display: none;
    }

    .d12-palette-flyout {
        left: calc(100% + var(--d12-tooltip-offset));
        bottom: 0;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .d12-palette-flyout-column {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 150px;
    }
</style>

@code {
    private RenderFragment RailButtonMarkup(RailButton button, int index, bool isTabStop) =>
        @<button
            type="button"
            class="@(button.IsEdge ? "d12-palette-button d12-palette-edge" : "d12-palette-button d12-palette-entry")"
            aria-label="@button.AccessibleName"
            tabindex="@(isTabStop ? "0" : "-1")"
            draggable="true"
            @ref="_buttonElements[index]"
            @onfocus="() => _activeIndex = index"
            @ondragstart="() => HandleDragStart(button.Key)"
            @onclick="() => HandleClick(button.Key)"
        >
            <D12Icon Glyph="button.Glyph" />
        </button>;

    private RenderFragment MoreButtonMarkup(int index, bool isTabStop) =>
        @<button
            type="button"
            class="d12-palette-button d12-palette-more-button"
            aria-label="@MoreName"
            aria-haspopup="menu"
            aria-expanded="@(_flyoutOpen ? "true" : "false")"
            tabindex="@(isTabStop ? "0" : "-1")"
            @ref="_buttonElements[index]"
            @onfocus="() => _activeIndex = index"
            @onclick="ToggleFlyout"
        >
            <D12Icon Glyph="MoreGlyph" />
        </button>;

    private RenderFragment OverflowMarkup =>
        @<text>
            @foreach (var category in OverflowCategories())
            {
                <div class="d12-palette-flyout-column" role="group" aria-label="@category.Key">
                    <div class="d12-flyout-heading" aria-hidden="true">@category.Key</div>
                    @foreach (var registration in category)
                    {
                        var key = registration.Key;
                        <button
                            type="button"
                            role="menuitem"
                            class="d12-flyout-item d12-palette-flyout-entry"
                            aria-label="@registration.AccessibleName"
                            tabindex="-1"
                            draggable="true"
                            @ondragstart="() => HandleDragStart(key)"
                            @ondragend="CloseFlyout"
                            @onclick="() => HandleFlyoutPick(key)"
                        >
                            <D12Icon Glyph="registration.IconOrDefault" />
                            <span>@registration.DisplayName</span>
                        </button>
                    }
                </div>
            }
        </text>;
}

@namespace D12Canvas

@using D12Canvas.Panel

<div class="d12-property-panel" role="region" aria-label="Property panel">
    @if (SelectedInstances.Count == 0)
    {
        <p class="d12-property-panel-empty">No selection</p>
    }
    else
    {
        <ul class="d12-property-panel-fields">
            @foreach (var field in Fields)
            {
                <li class="d12-property-panel-field">
                    <label class="d12-property-panel-label" for="@field.FieldId">@field.Label</label>
                    @switch (field.Kind)
                    {
                        case EditorKind.Text:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-input"
                                type="text"
                                value="@CurrentValue(field)"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Number:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-input"
                                type="number"
                                value="@CurrentValue(field)"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Color:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-input d12-property-panel-color"
                                type="color"
                                value="@CurrentValue(field)"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Checkbox:
                            <input
                                id="@field.FieldId"
                                class="d12-property-panel-checkbox"
                                type="checkbox"
                                checked="@CurrentBoolValue(field)"
                                @onchange="@(e => CommitEdit(field, e))"
                            />
                            break;
                        case EditorKind.Dropdown:
                            <select
                                id="@field.FieldId"
                                class="d12-property-panel-input"
                                value="@CurrentValue(field)"
                                @onchange="@(e => CommitEdit(field, e))"
                            >
                                @foreach (var option in field.Options!)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                            break;
                        case EditorKind.Custom:
                            <div id="@field.FieldId" class="d12-property-panel-custom">
                                @field.CustomEditor!(CustomContext(field))
                            </div>
                            break;
                    }
                </li>
            }
        </ul>
    }
</div>

<style>
    .d12-property-panel {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
        color-scheme: light;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        padding: 12px;
        box-sizing: border-box;
        color: var(--d12-text);
    }

    @@media (prefers-color-scheme: dark) {
        .d12-property-panel {
            --d12-surface: #2a2a2a;
            --d12-border: rgba(255, 255, 255, 0.12);
            --d12-accent: #2f80ed;
            --d12-muted-text: #a0a0a0;
            --d12-text: #e8e8e8;
            color-scheme: dark;
        }
    }

    .d12-property-panel[data-d12-theme="light"],
    [data-d12-theme="light"] .d12-property-panel {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
        color-scheme: light;
    }

    .d12-property-panel[data-d12-theme="dark"],
    [data-d12-theme="dark"] .d12-property-panel {
        --d12-surface: #2a2a2a;
        --d12-border: rgba(255, 255, 255, 0.12);
        --d12-accent: #2f80ed;
        --d12-muted-text: #a0a0a0;
        --d12-text: #e8e8e8;
        color-scheme: dark;
    }

    .d12-property-panel-empty {
        margin: 0;
        font-size: 13px;
        color: var(--d12-muted-text);
    }

    .d12-property-panel-fields {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .d12-property-panel-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .d12-property-panel-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--d12-muted-text);
    }

    .d12-property-panel-input {
        font: inherit;
        padding: 4px 6px;
        border: 1px solid var(--d12-border);
        border-radius: 4px;
        box-sizing: border-box;
        background: var(--d12-surface);
        color: inherit;
    }

    .d12-property-panel-color {
        padding: 2px;
        height: 28px;
    }

    .d12-property-panel-checkbox {
        width: 16px;
        height: 16px;
        align-self: flex-start;
    }

    .d12-property-panel-custom {
        display: flex;
    }
</style>

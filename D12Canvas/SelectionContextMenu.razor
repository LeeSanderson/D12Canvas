@namespace D12Canvas

<div class="d12-context-menu" role="menu" aria-label="Selection actions"
     style="@MenuStyle"
     @ref="_menuRef"
     @onkeydown="HandleKeyDown" @onkeydown:stopPropagation
     @oncontextmenu:preventDefault>
    <button type="button" class="d12-context-menu-item" role="menuitem" autofocus
            @onclick="InvokeDelete">Delete</button>
    @if (CanGroup)
    {
        <button type="button" class="d12-context-menu-item" role="menuitem"
                @onclick="InvokeGroup">Group</button>
    }
    @if (CanUngroup)
    {
        <button type="button" class="d12-context-menu-item" role="menuitem"
                @onclick="InvokeUngroup">Ungroup</button>
    }
    <div class="d12-context-menu-separator" role="separator"></div>
    <button type="button" class="d12-context-menu-item" role="menuitem"
            @onclick="InvokeBringToFront">Bring to Front</button>
    <button type="button" class="d12-context-menu-item" role="menuitem"
            @onclick="InvokeBringForward">Bring Forward</button>
    <button type="button" class="d12-context-menu-item" role="menuitem"
            @onclick="InvokeSendBackward">Send Backward</button>
    <button type="button" class="d12-context-menu-item" role="menuitem"
            @onclick="InvokeSendToBack">Send to Back</button>
</div>

<style>
    .d12-context-menu {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
        position: absolute;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        min-width: 160px;
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        padding: 4px;
        box-sizing: border-box;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        color: var(--d12-text);
    }

    @@media (prefers-color-scheme: dark) {
        .d12-context-menu {
            --d12-surface: #2a2a2a;
            --d12-border: rgba(255, 255, 255, 0.12);
            --d12-accent: #2f80ed;
            --d12-muted-text: #a0a0a0;
            --d12-text: #e8e8e8;
        }
    }

    .d12-context-menu[data-d12-theme="light"],
    [data-d12-theme="light"] .d12-context-menu {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
    }

    .d12-context-menu[data-d12-theme="dark"],
    [data-d12-theme="dark"] .d12-context-menu {
        --d12-surface: #2a2a2a;
        --d12-border: rgba(255, 255, 255, 0.12);
        --d12-accent: #2f80ed;
        --d12-muted-text: #a0a0a0;
        --d12-text: #e8e8e8;
    }

    .d12-context-menu-item {
        display: block;
        width: 100%;
        padding: 6px 10px;
        border: 1px solid transparent;
        border-radius: 4px;
        background: transparent;
        cursor: pointer;
        text-align: left;
        font: inherit;
        font-size: 13px;
        color: inherit;
    }

    .d12-context-menu-item:hover {
        background: color-mix(in srgb, var(--d12-border) 25%, var(--d12-surface));
        border-color: var(--d12-border);
    }

    .d12-context-menu-separator {
        height: 1px;
        margin: 4px 6px;
        background: var(--d12-border);
    }
</style>

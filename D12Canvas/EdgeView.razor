@namespace D12Canvas
@using D12Canvas.Model
@using D12Canvas.Pointer

@if (RoutingStyle == EdgeRouting.Straight)
{
    if (IsSelected)
    {
        <line x1="@From.X" y1="@From.Y" x2="@To.X" y2="@To.Y" class="edge-halo" />
    }
    <line x1="@From.X" y1="@From.Y" x2="@To.X" y2="@To.Y"
          class="edge-line"
          style="@ColorOverride"
          marker-start="@MarkerUrl(SourceArrow)"
          marker-end="@MarkerUrl(TargetArrow)"
          aria-selected="@(IsSelected ? "true" : null)" />
    <line x1="@From.X" y1="@From.Y" x2="@To.X" y2="@To.Y"
          class="edge-hit"
          data-d12-role="@HitRole.Edge" data-d12-entity="@EdgeId"
          data-d12-locked="@(Locked ? "true" : null)" />
}
else
{
    if (IsSelected)
    {
        <path d="@PathData" class="edge-halo" />
    }
    <path d="@PathData"
          class="edge-line"
          style="@ColorOverride"
          marker-start="@MarkerUrl(SourceArrow)"
          marker-end="@MarkerUrl(TargetArrow)"
          aria-selected="@(IsSelected ? "true" : null)" />
    <path d="@PathData"
          class="edge-hit"
          data-d12-role="@HitRole.Edge" data-d12-entity="@EdgeId"
          data-d12-locked="@(Locked ? "true" : null)" />
}

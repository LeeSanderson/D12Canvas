@namespace D12Canvas.BuiltIns

<div class="d12-rectangle" style="@Style"></div>

<style>
    .d12-rectangle {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        background-color: var(--d12-board-fill-override, var(--d12-board-fill));
        border-style: solid;
        border-color: var(--d12-board-stroke-override, var(--d12-board-stroke));
    }
</style>

@code {
    [Parameter]
    public RectangleProps Props { get; set; } = new(null, null, 2);

    private string Style =>
        ThemedDefault.Override("--d12-board-fill-override", Props.FillColor)
        + ThemedDefault.Override("--d12-board-stroke-override", Props.StrokeColor)
        + $"border-width: {Props.StrokeWidth}px;";
}

@namespace D12Canvas.BuiltIns
@using D12Canvas.Panel
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="d12-image-picture-editor">
    @if (Context.IsMixed)
    {
        <span class="d12-image-picture-mixed">@MixedValue.Label</span>
    }
    <button type="button" class="d12-image-picture-button" disabled="@(Context.AddAsset is null || Context.Disabled)" @onclick="ChooseFile">Choose file…</button>
    <button type="button" class="d12-image-picture-button" disabled="@Context.Disabled" @onclick="RemoveImage">Remove image</button>
</div>

<style>
    .d12-image-picture-editor {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .d12-image-picture-mixed {
        flex-basis: 100%;
        font-size: 12px;
        color: var(--d12-muted-text);
    }

    .d12-image-picture-button {
        font: inherit;
        font-size: 12px;
        padding: 2px 6px;
        border: 1px solid var(--d12-border);
        border-radius: 4px;
        background: transparent;
        color: inherit;
        cursor: pointer;
    }
</style>

@code {
    public const string ModulePath = "./_content/D12Canvas/imageFiles.js";

    [Parameter, EditorRequired]
    public CustomEditorContext Context { get; set; } = null!;

    private IJSObjectReference? _module;

    // Cancelling the picker, or picking a file the browser cannot decode, commits nothing.
    private async Task ChooseFile()
    {
        if (Context.AddAsset is not { } addAsset)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        var picked = await _module.InvokeAsync<HeldImage?>("chooseImageFile");
        if (picked is null)
        {
            return;
        }

        var bytes = await picked.TakeBytes(_module);
        if (bytes.Length > 0)
        {
            Context.Commit(addAsset(bytes, picked.MimeType));
        }
    }

    private void RemoveImage() => Context.Commit("");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}

@namespace D12Canvas

@using D12Canvas.Registration

<div class="d12-palette" role="region" aria-label="Component palette">
    @foreach (var category in Categories)
    {
        <div class="d12-palette-category">
            <h3 class="d12-palette-category-title">@category.Name</h3>
            <ul class="d12-palette-entries">
                @foreach (var entry in category.Entries)
                {
                    <li class="d12-palette-entry">
                        <button
                            type="button"
                            class="d12-palette-entry-button"
                            aria-label="@entry.AccessibleName"
                            draggable="true"
                            @ondragstart="() => HandleDragStart(entry.Key)"
                            @onclick="() => HandleClick(entry.Key)"
                        >
                            @if (!string.IsNullOrEmpty(entry.Icon))
                            {
                                <span class="d12-palette-entry-icon" aria-hidden="true">@entry.Icon</span>
                            }
                            <span class="d12-palette-entry-name">@entry.DisplayName</span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    }

    <!--
        A built-in, fixed entry - not a registry registration, since Edge is its
        own entity type, not something RegisterComponent covers. Rendered after
        every registered category (not inside the .d12-palette-category/.d12-palette-entry grouping
        markup above) so it always appears regardless of what's registered, without disturbing the
        category count or entry ordering registered types already rely on.
    -->
    <button
        type="button"
        class="d12-palette-entry-button"
        aria-label="Connector"
        draggable="true"
        @ondragstart="() => HandleDragStart(DiagramCanvas.ConnectorPaletteKey)"
        @onclick="() => HandleClick(DiagramCanvas.ConnectorPaletteKey)"
    >
        <span class="d12-palette-entry-name">Connector</span>
    </button>
</div>

<style>
    .d12-palette {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        padding: 12px;
        box-sizing: border-box;
        color: var(--d12-text);
    }

    @@media (prefers-color-scheme: dark) {
        .d12-palette {
            --d12-surface: #2a2a2a;
            --d12-border: rgba(255, 255, 255, 0.12);
            --d12-accent: #2f80ed;
            --d12-muted-text: #a0a0a0;
            --d12-text: #e8e8e8;
        }
    }

    .d12-palette[data-d12-theme="light"],
    [data-d12-theme="light"] .d12-palette {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
    }

    .d12-palette[data-d12-theme="dark"],
    [data-d12-theme="dark"] .d12-palette {
        --d12-surface: #2a2a2a;
        --d12-border: rgba(255, 255, 255, 0.12);
        --d12-accent: #2f80ed;
        --d12-muted-text: #a0a0a0;
        --d12-text: #e8e8e8;
    }

    .d12-palette-category-title {
        margin: 0 0 6px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--d12-muted-text);
    }

    .d12-palette-entries {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .d12-palette-entry-button {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 6px 8px;
        border: 1px solid transparent;
        border-radius: 4px;
        background: transparent;
        cursor: pointer;
        text-align: left;
        font: inherit;
        color: inherit;
    }

    .d12-palette-entry-button:hover {
        background: color-mix(in srgb, var(--d12-border) 25%, var(--d12-surface));
        border-color: var(--d12-border);
    }

    .d12-palette-entry-icon {
        font-size: 16px;
        line-height: 1;
    }

    .d12-palette-entry-name {
        font-size: 13px;
    }
</style>

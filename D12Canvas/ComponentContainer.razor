@namespace D12Canvas
@using D12Canvas.Model
@using D12Canvas.Pointer

<div class="@ContainerCssClass"
     style="@ContainerStyle"
     role="@Role"
     aria-label="@AccessibleName"
     aria-selected="@(IsSelected ? "true" : null)"
     tabindex="@(Focusable ? "0" : null)"
     data-d12-role="@(HasHitMarker ? HitRole.Instance : null)"
     data-d12-entity="@EntityId"
     data-d12-unaddressable="@(Addressable ? null : "true")"
     data-d12-locked="@(Locked ? "true" : null)"
     @onfocus="HandleFocus">

    <div class="container-content">
        @ChildContent
    </div>

    @* The border partition: each side's port spans and, on a selected shape, its resize spans.
       The spans are the hit regions and draw nothing; the cursor is what tells them apart. *@
    @foreach (var span in _partition)
    {
        if (span.Kind == BorderSpanKind.Port)
        {
            <div class="port-span port-span-@SideClass(span.Side)" style="@SpanStyle(span)"
                 data-d12-role="@HitRole.Port" data-d12-part="@PortPart(span)"></div>
        }
        else if (ShowSelectionOverlay)
        {
            <div class="resize-span resize-span-@SideClass(span.Side)" style="@SpanStyle(span)"
                 data-d12-role="@HitRole.ResizeHandle" data-d12-part="@SideClass(span.Side)"></div>
        }
    }

    @* Each port's dot, drawn where its span survives and wherever the keyboard pick highlights it. *@
    @foreach (var side in StandardPorts.All)
    {
        if (ShowsStandardPort(side))
        {
            <div class="@StandardPortCssClass(side)"></div>
        }
    }

    @foreach (var port in CustomPorts)
    {
        if (ShowsCustomPort(port.Id))
        {
            <div class="@CustomPortCssClass(port.Id)" style="@CustomPortStyle(port)" @key="port.Id"></div>
        }
    }

    @if (ProvisionalPort is { } provisional)
    {
        <div class="port port-focused port-provisional" style="@PortDotStyle(provisional.FractionX, provisional.FractionY)"></div>
    }

    @if (ShowSelectionOverlay)
    {
        <div class="resize-handle top-left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top-left"></div>
        <div class="resize-handle top-right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top-right"></div>
        <div class="resize-handle bottom-right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom-right"></div>
        <div class="resize-handle bottom-left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom-left"></div>
    }
</div>

<style>
    .component-container {
        position: absolute;
        min-width: 100px;
        min-height: 100px;
        box-sizing: border-box;
        border: 1px solid transparent;
        cursor: move;
        --d12-hit-target: calc(var(--d12-port-target) / var(--d12-scale));
        --d12-port-dot: calc(20px * max(1, 0.25 / var(--d12-scale)));
        --d12-corner-dot: calc(10px * max(1, 0.25 / var(--d12-scale)));
    }

    .container-content {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .component-container:focus {
        outline: none;
    }

    .component-container.selected {
        outline: 2px solid #2f80ed;
        outline-offset: 2px;
    }

    .port-span,
    .resize-span {
        position: absolute;
    }

    .port-span {
        cursor: crosshair;
    }

    .resize-span-top,
    .resize-span-bottom {
        cursor: ns-resize;
    }

    .resize-span-left,
    .resize-span-right {
        cursor: ew-resize;
    }

    .port-span-top,
    .resize-span-top,
    .port-span-bottom,
    .resize-span-bottom {
        height: calc(var(--d12-hit-target) / 2 + min(var(--d12-hit-target) / 2, 50%));
    }

    .port-span-left,
    .resize-span-left,
    .port-span-right,
    .resize-span-right {
        width: calc(var(--d12-hit-target) / 2 + min(var(--d12-hit-target) / 2, 50%));
    }

    .port-span-top,
    .resize-span-top {
        top: calc(var(--d12-hit-target) / -2);
    }

    .port-span-bottom,
    .resize-span-bottom {
        bottom: calc(var(--d12-hit-target) / -2);
    }

    .port-span-left,
    .resize-span-left {
        left: calc(var(--d12-hit-target) / -2);
    }

    .port-span-right,
    .resize-span-right {
        right: calc(var(--d12-hit-target) / -2);
    }

    .port {
        position: absolute;
        width: var(--d12-port-dot);
        height: var(--d12-port-dot);
        border-radius: 50%;
        background-color: #2ecc71;
        border: 2px solid #ffffff;
        pointer-events: none;
    }

    .port.port-focused {
        outline: 3px solid #f39c12;
        outline-offset: 2px;
    }

    .port.port-provisional {
        background-color: transparent;
        border-color: #2ecc71;
    }

    .port-top {
        top: calc(var(--d12-port-dot) / -2);
        left: calc(50% - var(--d12-port-dot) / 2);
    }

    .port-right {
        top: calc(50% - var(--d12-port-dot) / 2);
        right: calc(var(--d12-port-dot) / -2);
    }

    .port-bottom {
        bottom: calc(var(--d12-port-dot) / -2);
        left: calc(50% - var(--d12-port-dot) / 2);
    }

    .port-left {
        top: calc(50% - var(--d12-port-dot) / 2);
        left: calc(var(--d12-port-dot) / -2);
    }

    .resize-handle {
        position: absolute;
        width: min(var(--d12-hit-target), 50%);
        height: min(var(--d12-hit-target), 50%);
    }

    .resize-handle::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: var(--d12-corner-dot);
        height: var(--d12-corner-dot);
        margin-left: calc(var(--d12-corner-dot) / -2);
        margin-top: calc(var(--d12-corner-dot) / -2);
        border-radius: 50%;
        background-color: #3498db;
        pointer-events: none;
    }

    .resize-handle.top-left {
        top: calc(min(var(--d12-hit-target), 50%) / -2);
        left: calc(min(var(--d12-hit-target), 50%) / -2);
        cursor: nwse-resize;
    }

    .resize-handle.top-right {
        top: calc(min(var(--d12-hit-target), 50%) / -2);
        right: calc(min(var(--d12-hit-target), 50%) / -2);
        cursor: nesw-resize;
    }

    .resize-handle.bottom-right {
        bottom: calc(min(var(--d12-hit-target), 50%) / -2);
        right: calc(min(var(--d12-hit-target), 50%) / -2);
        cursor: nwse-resize;
    }

    .resize-handle.bottom-left {
        bottom: calc(min(var(--d12-hit-target), 50%) / -2);
        left: calc(min(var(--d12-hit-target), 50%) / -2);
        cursor: nesw-resize;
    }
</style>

@namespace D12Canvas
@using D12Canvas.Model
@using D12Canvas.Pointer

<div @ref="_containerRef"
     class="@ContainerCssClass"
     style="@ContainerStyle"
     role="@Role"
     aria-label="@AccessibleName"
     aria-selected="@(IsSelected ? "true" : null)"
     tabindex="@(Focusable ? "0" : null)"
     data-d12-role="@HitRole.Instance"
     data-d12-entity="@EntityId"
     data-d12-unaddressable="@(Addressable ? null : "true")"
     @onmousedown="HandleMouseDown"
     @onmousedown:stopPropagation
     @onmousemove="HandleMouseMove"
     @onmousemove:stopPropagation
     @onmouseup="HandleMouseUp"
     @onmouseup:stopPropagation
     @onfocus="HandleFocus"
     @ondblclick="SwitchToEditMode">

    <div class="container-content">
        @ChildContent
    </div>

    @* A double-click anywhere along one of these four border strips adds a
       custom port there. Rendered before the ports below (and so painted underneath them, later
       markup wins the same stacking-context tie-break the ports/resize-handles comment below
       relies on) so a standard or custom port's own small hit circle always wins a click over the
       broader strip beneath it - only the rest of the border reaches this handler. Stops
       propagation so it doesn't also enter edit mode (the container's own @ondblclick). *@
    @if (ShowSelectionOverlay)
    {
        <div class="port-strip port-strip-top" data-d12-role="@HitRole.PortStrip" data-d12-part="top" @ondblclick="@((e) => AddCustomPort(e, PortStripSide.Top))" @ondblclick:stopPropagation></div>
        <div class="port-strip port-strip-right" data-d12-role="@HitRole.PortStrip" data-d12-part="right" @ondblclick="@((e) => AddCustomPort(e, PortStripSide.Right))" @ondblclick:stopPropagation></div>
        <div class="port-strip port-strip-bottom" data-d12-role="@HitRole.PortStrip" data-d12-part="bottom" @ondblclick="@((e) => AddCustomPort(e, PortStripSide.Bottom))" @ondblclick:stopPropagation></div>
        <div class="port-strip port-strip-left" data-d12-role="@HitRole.PortStrip" data-d12-part="left" @ondblclick="@((e) => AddCustomPort(e, PortStripSide.Left))" @ondblclick:stopPropagation></div>
    }

    @* The four standard ports are automatic on every instance - no
       registration opt-in, so they're rendered unconditionally here rather than sourced from
       Props/registration. Fractional border-center placement (and staying there through move and
       resize) comes for free from positioning each one in plain CSS percentages of this container's
       own box - no per-instance computation needed. Visibility (hover/selection) is CSS-only too
       (see .port rules below), so no C# state or extra render is involved. *@
    @* Each port's own mousedown starts a connector drag (StartPortDrag) - it doesn't
       stop propagation, so it still bubbles up to HandleMouseDown afterwards, matching how the
       resize handles below interact with that same handler. Each prevents its own mousedown so the
       drag selects no text; the container itself does not, so an author's own control inside it
       keeps the browser's focus and text selection. *@
    <div class="@StandardPortCssClass(PortId.Top)" data-d12-role="@HitRole.Port" data-d12-part="Top" @onmousedown="@((e) => StartPortDrag(e, PortRef.Standard(PortId.Top)))" @onmousedown:preventDefault></div>
    <div class="@StandardPortCssClass(PortId.Right)" data-d12-role="@HitRole.Port" data-d12-part="Right" @onmousedown="@((e) => StartPortDrag(e, PortRef.Standard(PortId.Right)))" @onmousedown:preventDefault></div>
    <div class="@StandardPortCssClass(PortId.Bottom)" data-d12-role="@HitRole.Port" data-d12-part="Bottom" @onmousedown="@((e) => StartPortDrag(e, PortRef.Standard(PortId.Bottom)))" @onmousedown:preventDefault></div>
    <div class="@StandardPortCssClass(PortId.Left)" data-d12-role="@HitRole.Port" data-d12-part="Left" @onmousedown="@((e) => StartPortDrag(e, PortRef.Standard(PortId.Left)))" @onmousedown:preventDefault></div>

    @* An instance's own runtime-added custom ports - the same drag-to-connect affordance
       as a standard port (StartPortDrag), just at a user-chosen fractional position instead of a
       fixed border-center one, so its own inline style (not a CSS class) positions it. *@
    @foreach (var port in CustomPorts)
    {
        <div class="@CustomPortCssClass(port.Id)" style="@CustomPortStyle(port)"
             data-d12-role="@HitRole.Port" data-d12-part="@port.Id"
             @onmousedown="@((e) => StartPortDrag(e, PortRef.Custom(port.Id)))" @onmousedown:preventDefault
             @key="port.Id"></div>
    }

    @if (ShowSelectionOverlay)
    {
        <div class="resize-handle top-left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top-left" @onmousedown="@((e) => StartResize(e, ResizeDirection.TopLeft))" @onmousedown:preventDefault></div>
        <div class="resize-handle top" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top" @onmousedown="@((e) => StartResize(e, ResizeDirection.Top))" @onmousedown:preventDefault></div>
        <div class="resize-handle top-right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top-right" @onmousedown="@((e) => StartResize(e, ResizeDirection.TopRight))" @onmousedown:preventDefault></div>
        <div class="resize-handle right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="right" @onmousedown="@((e) => StartResize(e, ResizeDirection.Right))" @onmousedown:preventDefault></div>
        <div class="resize-handle bottom-right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom-right" @onmousedown="@((e) => StartResize(e, ResizeDirection.BottomRight))" @onmousedown:preventDefault></div>
        <div class="resize-handle bottom" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom" @onmousedown="@((e) => StartResize(e, ResizeDirection.Bottom))" @onmousedown:preventDefault></div>
        <div class="resize-handle bottom-left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom-left" @onmousedown="@((e) => StartResize(e, ResizeDirection.BottomLeft))" @onmousedown:preventDefault></div>
        <div class="resize-handle left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="left" @onmousedown="@((e) => StartResize(e, ResizeDirection.Left))" @onmousedown:preventDefault></div>
    }
</div>

<style>
    .component-container {
        position: absolute;
        min-width: 100px;
        min-height: 100px;
        box-sizing: border-box;
        cursor: move;
    }

    .container-content {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .component-container.edit-mode {
        border: 2px solid #3498db;
        padding: 2px;
    }

    .component-container.view-mode {
        border: 1px solid transparent;
    }

    .component-container.selected {
        outline: 2px solid #2f80ed;
        outline-offset: 2px;
    }

    .component-container:focus {
        outline: none;
    }

    .port {
        position: absolute;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #2ecc71;
        border: 2px solid #ffffff;
        opacity: 0;
        pointer-events: none;
        cursor: crosshair;
    }

    .component-container:hover .port,
    .component-container.selected .port {
        opacity: 1;
        pointer-events: auto;
    }

    .port.port-focused {
        opacity: 1;
        outline: 3px solid #f39c12;
        outline-offset: 2px;
    }

    .port-top {
        top: -10px;
        left: calc(50% - 10px);
    }

    .port-right {
        top: calc(50% - 10px);
        right: -10px;
    }

    .port-bottom {
        bottom: -10px;
        left: calc(50% - 10px);
    }

    .port-left {
        top: calc(50% - 10px);
        left: -10px;
    }

    .port-strip {
        position: absolute;
        cursor: copy;
    }

    .port-strip-top,
    .port-strip-bottom {
        left: 0;
        right: 0;
        height: 14px;
    }

    .port-strip-top {
        top: -7px;
    }

    .port-strip-bottom {
        bottom: -7px;
    }

    .port-strip-left,
    .port-strip-right {
        top: 0;
        bottom: 0;
        width: 14px;
    }

    .port-strip-left {
        left: -7px;
    }

    .port-strip-right {
        right: -7px;
    }

    .resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #3498db;
        border-radius: 50%;
    }

    .top-left {
        top: -5px;
        left: -5px;
        cursor: nwse-resize;
    }

    .top {
        top: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .top-right {
        top: -5px;
        right: -5px;
        cursor: nesw-resize;
    }

    .right {
        top: calc(50% - 5px);
        right: -5px;
        cursor: ew-resize;
    }

    .bottom-right {
        bottom: -5px;
        right: -5px;
        cursor: nwse-resize;
    }

    .bottom {
        bottom: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .bottom-left {
        bottom: -5px;
        left: -5px;
        cursor: nesw-resize;
    }

    .left {
        top: calc(50% - 5px);
        left: -5px;
        cursor: ew-resize;
    }
</style>

@namespace D12Canvas
@using D12Canvas.Model

<div @ref="_containerRef"
     class="@ContainerCssClass"
     style="@ContainerStyle"
     role="@Role"
     aria-label="@AccessibleName"
     aria-selected="@(IsSelected ? "true" : null)"
     @onmousedown="HandleMouseDown"
     @onmousedown:stopPropagation
     @onmousemove="HandleMouseMove"
     @onmousemove:stopPropagation
     @onmouseup="HandleMouseUp"
     @onmouseup:stopPropagation
     @onclick="HandleClick"
     @onclick:stopPropagation
     @ondblclick="SwitchToEditMode">

    <div class="container-content">
        @ChildContent
    </div>

    @* Ticket 47: the four standard ports are automatic on every instance (ADR 0005) - no
       registration opt-in, so they're rendered unconditionally here rather than sourced from
       Props/registration. Fractional border-center placement (and staying there through move and
       resize) comes for free from positioning each one in plain CSS percentages of this container's
       own box - no per-instance computation needed. Visibility (hover/selection) is CSS-only too
       (see .port rules below), so no C# state or extra render is involved. *@
    @* Ticket 48: each port's own mousedown starts a connector drag (StartPortDrag) - it doesn't
       stop propagation, so it still bubbles up to HandleMouseDown afterwards, matching how the
       resize handles below interact with that same handler. *@
    <div class="port port-top" @onmousedown="@((e) => StartPortDrag(e, PortId.Top))"></div>
    <div class="port port-right" @onmousedown="@((e) => StartPortDrag(e, PortId.Right))"></div>
    <div class="port port-bottom" @onmousedown="@((e) => StartPortDrag(e, PortId.Bottom))"></div>
    <div class="port port-left" @onmousedown="@((e) => StartPortDrag(e, PortId.Left))"></div>

    @if ((IsSelected && !IsMultiSelected) || _editMode)
    {
        <div class="resize-handle top-left" @onmousedown="@((e) => StartResize(e, ResizeDirection.TopLeft))"></div>
        <div class="resize-handle top" @onmousedown="@((e) => StartResize(e, ResizeDirection.Top))"></div>
        <div class="resize-handle top-right" @onmousedown="@((e) => StartResize(e, ResizeDirection.TopRight))"></div>
        <div class="resize-handle right" @onmousedown="@((e) => StartResize(e, ResizeDirection.Right))"></div>
        <div class="resize-handle bottom-right" @onmousedown="@((e) => StartResize(e, ResizeDirection.BottomRight))"></div>
        <div class="resize-handle bottom" @onmousedown="@((e) => StartResize(e, ResizeDirection.Bottom))"></div>
        <div class="resize-handle bottom-left" @onmousedown="@((e) => StartResize(e, ResizeDirection.BottomLeft))"></div>
        <div class="resize-handle left" @onmousedown="@((e) => StartResize(e, ResizeDirection.Left))"></div>
    }
</div>

<style>
    .component-container {
        position: absolute;
        min-width: 100px;
        min-height: 100px;
        box-sizing: border-box;
        cursor: move;
    }

    .container-content {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .component-container.edit-mode {
        border: 2px solid #3498db;
        padding: 2px;
    }

    .component-container.view-mode {
        border: 1px solid transparent;
    }

    .component-container.selected {
        outline: 2px solid #2f80ed;
        outline-offset: 2px;
    }

    /* Ticket 47: standard ports, hidden until hover/selection. Rendered before the resize handles
       below in markup order, so a selected instance's edge-midpoint resize handle (same
       border-center point as its port) paints on top of it. Sized noticeably larger than the 10px
       resize handle (box-sizing is border-box app-wide, via Bootstrap's reboot, so this 20px port's
       own 2px border eats inward rather than adding outward) so its green fill still forms a
       visible ring around the handle instead of being fully hidden behind it. */
    .port {
        position: absolute;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #2ecc71;
        border: 2px solid #ffffff;
        opacity: 0;
        pointer-events: none;
        cursor: crosshair;
    }

    /* Ticket 48: a port only becomes interactive (pointer-events: auto) exactly when it's
       visible - matches the opacity rule so a hidden port can never intercept a click meant for
       the container underneath it. */
    .component-container:hover .port,
    .component-container.selected .port {
        opacity: 1;
        pointer-events: auto;
    }

    .port-top {
        top: -10px;
        left: calc(50% - 10px);
    }

    .port-right {
        top: calc(50% - 10px);
        right: -10px;
    }

    .port-bottom {
        bottom: -10px;
        left: calc(50% - 10px);
    }

    .port-left {
        top: calc(50% - 10px);
        left: -10px;
    }

    .resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #3498db;
        border-radius: 50%;
    }

    .top-left {
        top: -5px;
        left: -5px;
        cursor: nwse-resize;
    }

    .top {
        top: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .top-right {
        top: -5px;
        right: -5px;
        cursor: nesw-resize;
    }

    .right {
        top: calc(50% - 5px);
        right: -5px;
        cursor: ew-resize;
    }

    .bottom-right {
        bottom: -5px;
        right: -5px;
        cursor: nwse-resize;
    }

    .bottom {
        bottom: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .bottom-left {
        bottom: -5px;
        left: -5px;
        cursor: nesw-resize;
    }

    .left {
        top: calc(50% - 5px);
        left: -5px;
        cursor: ew-resize;
    }
</style>

@namespace D12Canvas
@using D12Canvas.Model
@using D12Canvas.Pointer

<div class="@ContainerCssClass"
     style="@ContainerStyle"
     role="@Role"
     aria-label="@AccessibleName"
     aria-selected="@(IsSelected ? "true" : null)"
     tabindex="@(Focusable ? "0" : null)"
     data-d12-role="@HitRole.Instance"
     data-d12-entity="@EntityId"
     data-d12-unaddressable="@(Addressable ? null : "true")"
     @onfocus="HandleFocus">

    <div class="container-content">
        @ChildContent
    </div>

    @* The four border strips. A drag from one pulls an edge from that side's port, and a
       double-press adds a custom port where it landed. Rendered before the ports below, and so
       painted underneath them, so a port's own small circle always wins over the broader strip. *@
    @if (ShowSelectionOverlay)
    {
        <div class="port-strip port-strip-top" data-d12-role="@HitRole.PortStrip" data-d12-part="top"></div>
        <div class="port-strip port-strip-right" data-d12-role="@HitRole.PortStrip" data-d12-part="right"></div>
        <div class="port-strip port-strip-bottom" data-d12-role="@HitRole.PortStrip" data-d12-part="bottom"></div>
        <div class="port-strip port-strip-left" data-d12-role="@HitRole.PortStrip" data-d12-part="left"></div>
    }

    @* The four standard ports are automatic on every instance - no
       registration opt-in, so they're rendered unconditionally here rather than sourced from
       Props/registration. Fractional border-center placement (and staying there through move and
       resize) comes for free from positioning each one in plain CSS percentages of this container's
       own box - no per-instance computation needed. Visibility (hover/selection) is CSS-only too
       (see .port rules below), so no C# state or extra render is involved. *@
    <div class="@StandardPortCssClass(PortId.Top)" data-d12-role="@HitRole.Port" data-d12-part="Top"></div>
    <div class="@StandardPortCssClass(PortId.Right)" data-d12-role="@HitRole.Port" data-d12-part="Right"></div>
    <div class="@StandardPortCssClass(PortId.Bottom)" data-d12-role="@HitRole.Port" data-d12-part="Bottom"></div>
    <div class="@StandardPortCssClass(PortId.Left)" data-d12-role="@HitRole.Port" data-d12-part="Left"></div>

    @* An instance's own runtime-added custom ports - the same affordance as a standard port,
       just at a user-chosen fractional position instead of a fixed border-center one, so its own
       inline style (not a CSS class) positions it. *@
    @foreach (var port in CustomPorts)
    {
        <div class="@CustomPortCssClass(port.Id)" style="@CustomPortStyle(port)"
             data-d12-role="@HitRole.Port" data-d12-part="@port.Id"
             @key="port.Id"></div>
    }

    @if (ShowSelectionOverlay)
    {
        <div class="resize-handle top-left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top-left"></div>
        <div class="resize-handle top" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top"></div>
        <div class="resize-handle top-right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="top-right"></div>
        <div class="resize-handle right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="right"></div>
        <div class="resize-handle bottom-right" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom-right"></div>
        <div class="resize-handle bottom" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom"></div>
        <div class="resize-handle bottom-left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="bottom-left"></div>
        <div class="resize-handle left" data-d12-role="@HitRole.ResizeHandle" data-d12-part="left"></div>
    }
</div>

<style>
    .component-container {
        position: absolute;
        min-width: 100px;
        min-height: 100px;
        box-sizing: border-box;
        border: 1px solid transparent;
        cursor: move;
    }

    .container-content {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .component-container.selected {
        outline: 2px solid #2f80ed;
        outline-offset: 2px;
    }

    .component-container:focus {
        outline: none;
    }

    .port {
        position: absolute;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #2ecc71;
        border: 2px solid #ffffff;
        opacity: 0;
        pointer-events: none;
        cursor: crosshair;
    }

    .component-container:hover .port,
    .component-container.selected .port,
    .diagram-canvas.connecting .port {
        opacity: 1;
        pointer-events: auto;
    }

    .port.port-focused {
        opacity: 1;
        outline: 3px solid #f39c12;
        outline-offset: 2px;
    }

    .port-top {
        top: -10px;
        left: calc(50% - 10px);
    }

    .port-right {
        top: calc(50% - 10px);
        right: -10px;
    }

    .port-bottom {
        bottom: -10px;
        left: calc(50% - 10px);
    }

    .port-left {
        top: calc(50% - 10px);
        left: -10px;
    }

    .port-strip {
        position: absolute;
        cursor: copy;
    }

    .port-strip-top,
    .port-strip-bottom {
        left: 0;
        right: 0;
        height: 14px;
    }

    .port-strip-top {
        top: -7px;
    }

    .port-strip-bottom {
        bottom: -7px;
    }

    .port-strip-left,
    .port-strip-right {
        top: 0;
        bottom: 0;
        width: 14px;
    }

    .port-strip-left {
        left: -7px;
    }

    .port-strip-right {
        right: -7px;
    }

    .resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #3498db;
        border-radius: 50%;
    }

    .top-left {
        top: -5px;
        left: -5px;
        cursor: nwse-resize;
    }

    .top {
        top: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .top-right {
        top: -5px;
        right: -5px;
        cursor: nesw-resize;
    }

    .right {
        top: calc(50% - 5px);
        right: -5px;
        cursor: ew-resize;
    }

    .bottom-right {
        bottom: -5px;
        right: -5px;
        cursor: nwse-resize;
    }

    .bottom {
        bottom: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .bottom-left {
        bottom: -5px;
        left: -5px;
        cursor: nesw-resize;
    }

    .left {
        top: calc(50% - 5px);
        left: -5px;
        cursor: ew-resize;
    }
</style>

@namespace D12Canvas

@page "/diagram"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using D12Canvas
@using D12Canvas.Model
@using D12Canvas.Pointer
@using D12Canvas.Registration
@using System.Collections.Generic;

<div class="diagram-container" @ref="ContainerElement">
    <div class="grid-backdrop"></div>
    @foreach (var layer in VisibleGridLayers())
    {
        <div @key="layer.Level" class="grid-layer" style="@GridLayerStyle(layer)"></div>
    }
    <div class="@CanvasCssClass"
         @ref="CanvasElement"
         tabindex="-1"
         @onfocus="@HandleCanvasFocus"
         @ondragenter="@HandleDragEnterOrOver" @ondragenter:preventDefault="true"
         @ondragover="@HandleDragEnterOrOver" @ondragover:preventDefault="true"
         @ondragleave="@HandleDragLeave"
         @ondrop="@HandleDrop" @ondrop:preventDefault="true">
        <div class="canvas-content" style="@ContentStyle">
            <CascadingValue Value="this" Name="ParentCanvas">
            <div class="edge-band">
            <svg class="edges-layer">
                @if (Board is not null)
                {
                    @* One pair of arrowhead markers per selection state (not per edge) -
                       orient="auto-start-reverse" lets the same marker point correctly whether
                       it's used as marker-start or marker-end. Gated on there being at least one
                       edge (rather than unconditional) so a board with none renders byte-identical
                       markup to before - every other visual test's own baseline
                       already depends on that, since any edit to this shared
                       markup/CSS re-triggers every Playwright HTML snapshot. *@
                    if (Board.Edges.Count > 0)
                    {
                        <defs>
                            <marker id="edge-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrowhead" />
                            </marker>
                            <marker id="edge-arrow-selected" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrowhead selected" />
                            </marker>
                        </defs>
                    }
                    @* Each edge is drawn by a line that takes no presses and hit by a wider
                       transparent stroke over it, a constant 20 screen pixels at any zoom. *@
                    @foreach (var edge in Board.Edges)
                    {
                        if (!IsCarried(edge.Id))
                        {
                            var line = EdgeLine(edge);
                            if (line is not null)
                            {
                                var markerStart = EdgeMarkerUrl(edge.SourceArrow, IsEdgeSelected(edge.Id));
                                var markerEnd = EdgeMarkerUrl(edge.TargetArrow, IsEdgeSelected(edge.Id));
                                if (edge.RoutingStyle == EdgeRouting.Straight)
                                {
                                    <line @key="edge.Id" x1="@line.Value.From.X" y1="@line.Value.From.Y" x2="@line.Value.To.X" y2="@line.Value.To.Y"
                                      class="@EdgeLineCssClass(edge.Id)"
                                      marker-start="@markerStart"
                                      marker-end="@markerEnd"
                                      aria-selected="@(IsEdgeSelected(edge.Id) ? "true" : null)" />
                                    <line @key="@($"{edge.Id}-hit")" x1="@line.Value.From.X" y1="@line.Value.From.Y" x2="@line.Value.To.X" y2="@line.Value.To.Y"
                                      class="edge-hit"
                                      data-d12-role="@HitRole.Edge" data-d12-entity="@edge.Id" />
                                }
                                else
                                {
                                    var pathD = EdgePathD(edge.RoutingStyle, line.Value.From, line.Value.To);
                                    <path @key="edge.Id" d="@pathD"
                                      class="@EdgeLineCssClass(edge.Id)"
                                      marker-start="@markerStart"
                                      marker-end="@markerEnd"
                                      aria-selected="@(IsEdgeSelected(edge.Id) ? "true" : null)" />
                                    <path @key="@($"{edge.Id}-hit")" d="@pathD"
                                      class="edge-hit"
                                      data-d12-role="@HitRole.Edge" data-d12-entity="@edge.Id" />
                                }
                            }
                        }
                    }
                }
            </svg>
            @if (Board is not null)
            {
                @* A label is embedded on its Edge, not a Board.Components
                   entry, so it's rendered here directly rather than via VisibleComponents/
                   ComponentContainer (it's never independently selectable, movable, or resizable).
                   Its box is fully live-derived every render (EdgeLabelStyle) - skipped entirely
                   when the edge has no label or its line can't currently be resolved. *@
                @foreach (var edge in Board.Edges)
                {
                    if (EdgeLabelStyle(edge) is { } labelStyle)
                    {
                        var labelRegistration = Registry.Resolve(edge.Label!.ComponentTypeKey);
                        <div @key="@($"{edge.Id}-label")" class="edge-label" style="@labelStyle"
                             data-d12-role="@HitRole.EdgeLabel" data-d12-entity="@edge.Id">
                            <CascadingValue Value="edge.Label.Id" Name="InstanceId">
                                <DynamicComponent @ref="_mountedLabels[edge.Id]" Type="labelRegistration.ComponentType" Parameters="ComponentParameters(BoundProps(edge.Label, labelRegistration))" />
                            </CascadingValue>
                        </div>
                    }
                }
            }
            </div>
            <div class="instance-layer">
            @if (Board is not null)
            {
                @foreach (var stop in OrderedTabStops())
                {
                    if (stop.Instance is { } instance)
                    {
                        var registration = Registry.Resolve(instance.ComponentTypeKey);
                        @* Below the on-screen-size threshold, swap the whole
                           ComponentContainer/DynamicComponent tree for a plain box built from the
                           registration's own DisplayName/Icon - avoids mounting cost entirely rather
                           than mounting it small, and needs no change to what the registration
                           contract requires of a component type. It is still a hit target with the
                           instance role, so a zoomed-out board stays reachable. *@
                        if (IsPlaceholder(instance))
                        {
                            <div @key="instance.Id"
                                 class="lod-placeholder"
                                 data-d12-role="@(HasHitRegion(instance.Id) ? HitRole.Instance : null)" data-d12-entity="@instance.Id"
                                 style="@LodPlaceholderStyle(stop.Bounds, instance.ZIndex)"
                                 aria-hidden="true">
                                @if (!string.IsNullOrEmpty(registration.Icon))
                                {
                                    <span class="lod-placeholder-icon">@registration.Icon</span>
                                }
                                <span class="lod-placeholder-label">@registration.DisplayName</span>
                            </div>
                        }
                        else
                        {
                            var boundProps = BoundProps(instance, registration);
                            <ComponentContainer @key="instance.Id"
                                                EntityId="instance.Id"
                                                HasHitRegion="@HasHitRegion(instance.Id)"
                                                X="stop.Bounds.X"
                                                Y="stop.Bounds.Y"
                                                Width="stop.Bounds.Width"
                                                Height="stop.Bounds.Height"
                                                ZIndex="instance.ZIndex"
                                                AccessibleName="@registration.AccessibleName"
                                                Role="@registration.Role"
                                                IsSelected="@IsSelected(instance.Id)"
                                                IsMultiSelected="@IsMultiSelected(instance.Id)"
                                                Focusable="@IsAddressable(instance.Id)"
                                                Addressable="@IsAddressable(instance.Id)"
                                                Props="boundProps"
                                                OnFocus="@(() => FocusEntity(instance.Id))"
                                                FocusedPortId="@FocusedStandardPortIdFor(instance.Id)"
                                                FocusedCustomPortId="@FocusedCustomPortIdFor(instance.Id)"
                                                AutoPortFocused="@(FocusedPortEndpointFor(instance.Id) is AutoPortEndpoint)"
                                                Scale="_zoomPanTracker.Scale"
                                                IsDropTarget="@(_preview.PendingEdge?.DropTargetId == instance.Id)"
                                                CustomPorts="instance.CustomPorts">
                                @* Lets a text-carrying built-in (Sticky Note, Text) identify
                                   itself back to ParentCanvas when committing its own inline WYSIWYG edit -
                                   see CommitPropsChange. Harmless for any built-in that doesn't consume it. *@
                                <CascadingValue Value="instance.Id" Name="InstanceId">
                                    <DynamicComponent @ref="_mountedComponents[instance.Id]" Type="registration.ComponentType" Parameters="ComponentParameters(boundProps)" />
                                </CascadingValue>
                            </ComponentContainer>
                        }
                    }
                    else if (stop.Group is { } group)
                    {
                        @* A persisted Group's own single tab stop - invisible and
                           mouse-transparent (pointer-events: none; selecting the group by mouse
                           still goes through clicking one of its members), it exists
                           purely so Tab/Shift+Tab can reach the group as one stop instead of each
                           member individually. Selecting the group already renders the shared
                           .selection-bounding-box overlay (HasMultiMemberSelection) as this stop's
                           own visible focus indicator; focused but unselected, inside additive
                           traversal, it draws the dashed focus ring instead. *@
                        <div @key="group.Id"
                             class="group-tab-stop"
                             style="@BoxStyle(stop.Bounds)"
                             tabindex="0"
                             role="group"
                             aria-label="@GroupAccessibleLabel(group)"
                             aria-selected="@(IsGroupSelected(group.Id) ? "true" : null)"
                             @onfocus="@(() => FocusEntity(group.Id))"></div>
                    }
                    else if (stop.Edge is { } edge)
                    {
                        @* The edge's line sits in the SVG ahead of every stop in the DOM, so an
                           invisible proxy here carries its place in the ring; the selected
                           edge's halo is its focus indicator, and the dashed focus ring
                           outlines the proxy when it is focused but unselected. *@
                        <div @key="@($"{edge.Id}-stop")"
                             class="edge-tab-stop"
                             style="@BoxStyle(stop.Bounds)"
                             tabindex="0"
                             aria-label="@EdgeAccessibleLabel(edge)"
                             aria-selected="@(IsEdgeSelected(edge.Id) ? "true" : null)"
                             @onfocus="@(() => FocusEntity(edge.Id))"></div>
                    }
                }
            }
            @ChildContent
            </div>
            <div class="guide-layer">
                @if (EnteredGroupOutlineStyle() is { } enteredGroupOutline)
                {
                    <div class="entered-group-outline" style="@enteredGroupOutline"></div>
                }
                @if (_preview.Guides.Count > 0)
                {
                    <svg class="guide-strokes">
                        @foreach (var segment in GuideSegments())
                        {
                            <line x1="@segment.X1" y1="@segment.Y1" x2="@segment.X2" y2="@segment.Y2" class="@segment.Kind" vector-effect="non-scaling-stroke" />
                        }
                    </svg>
                }
            </div>
            <div class="selection-chrome">
            <svg class="chrome-strokes">
                @if (Board is not null)
                {
                    @* A draggable marker for each unattached edge endpoint. *@
                    @foreach (var floating in FloatingEndpoints())
                    {
                        <circle @key="@($"{floating.Edge.Id}-{(floating.IsSource ? "source" : "target")}")"
                                cx="@floating.X" cy="@floating.Y" r="6" class="floating-endpoint"
                                data-d12-role="@HitRole.EdgeEndpoint" data-d12-entity="@floating.Edge.Id" data-d12-part="@(floating.IsSource ? "source" : "target")"></circle>
                    }
                }
                @if (PendingEdgeLine() is { } pendingLine)
                {
                    <line x1="@pendingLine.From.X" y1="@pendingLine.From.Y" x2="@pendingLine.To.X" y2="@pendingLine.To.Y" class="connector-drag-preview" />
                }
            </svg>
            @if (_marqueeBounds is not null)
            {
                <div class="marquee-select" style="@MarqueeStyle"></div>
            }
            @if (HasMultiMemberSelection)
            {
                @* The box is a solid hit target: a press anywhere inside the multi-selection's
                   bounds lands on it rather than on whatever sits beneath, and moves the whole
                   selection. A press on one of its handles resizes the selection instead. *@
                <div class="selection-bounding-box" style="@SelectionBoundingBoxStyle"
                     data-d12-role="@HitRole.SelectionBounds">
                    <div class="group-resize-handle top-left" data-d12-role="@HitRole.SelectionHandle" data-d12-part="top-left"></div>
                    <div class="group-resize-handle top" data-d12-role="@HitRole.SelectionHandle" data-d12-part="top"></div>
                    <div class="group-resize-handle top-right" data-d12-role="@HitRole.SelectionHandle" data-d12-part="top-right"></div>
                    <div class="group-resize-handle right" data-d12-role="@HitRole.SelectionHandle" data-d12-part="right"></div>
                    <div class="group-resize-handle bottom-right" data-d12-role="@HitRole.SelectionHandle" data-d12-part="bottom-right"></div>
                    <div class="group-resize-handle bottom" data-d12-role="@HitRole.SelectionHandle" data-d12-part="bottom"></div>
                    <div class="group-resize-handle bottom-left" data-d12-role="@HitRole.SelectionHandle" data-d12-part="bottom-left"></div>
                    <div class="group-resize-handle left" data-d12-role="@HitRole.SelectionHandle" data-d12-part="left"></div>
                </div>
            }
            </div>
            </CascadingValue>
        </div>
    </div>
    @if (_isDragOverBoard)
    {
        <div class="drag-over-affordance"></div>
    }
    @* A sibling of .diagram-canvas (like .drag-over-affordance above), not
       nested inside .canvas-content - canvas chrome (CONTEXT.md) must not pan/zoom with board
       content, so its anchor (_contextMenu.X/Y) is plain container-relative pixels, not board space. *@
    @if (_contextMenu is not null)
    {
        <ContextMenu Context="ContextMenuContextFor(_contextMenu.Set)"
                     X="_contextMenu.X" Y="_contextMenu.Y"
                     ContainerWidth="_zoomPanTracker.ContainerWidth"
                     ContainerHeight="_zoomPanTracker.ContainerHeight"
                     OpenedFromKeyboard="_contextMenu.OpenedFromKeyboard"
                     OnInvoke="InvokeFromContextMenu"
                     OnRequestClose="CloseContextMenu" />
    }
</div>

<style>
    .diagram-container {
        --d12-surface: #f0f0f0;
        --d12-border: rgba(0, 0, 0, 0.1);
        --d12-accent: #2f80ed;
        --d12-muted-text: #6b6b6b;
        --d12-text: #212529;
        --d12-connector-preview: #2ecc71;
        --d12-alignment-guide: #e5246b;
        --d12-board-text: #000000;
        --d12-board-fill: #FFFFFF;
        --d12-board-stroke: #333333;
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-rows: minmax(400px, auto) minmax(400px, 100%);
        position: relative;
        overflow: hidden;
        border: 1px solid #ccc;
    }

    @@media (prefers-color-scheme: dark) {
        .diagram-container {
            --d12-surface: #1e1e1e;
            --d12-border: rgba(255, 255, 255, 0.12);
            --d12-accent: #2f80ed;
            --d12-muted-text: #a0a0a0;
            --d12-text: #e8e8e8;
            --d12-board-text: #e8e8e8;
            --d12-board-fill: #2e2e2e;
            --d12-board-stroke: #8a8a8a;
            --d12-alignment-guide: #ff5c97;
        }
    }

    .diagram-container[data-d12-theme="light"],
    [data-d12-theme="light"] .diagram-container {
        --d12-surface: #f0f0f0;
        --d12-border: rgba(0, 0, 0, 0.1);
        --d12-accent: #2f80ed;
        --d12-muted-text: #6b6b6b;
        --d12-text: #212529;
        --d12-board-text: #000000;
        --d12-board-fill: #FFFFFF;
        --d12-board-stroke: #333333;
        --d12-alignment-guide: #e5246b;
    }

    .diagram-container[data-d12-theme="dark"],
    [data-d12-theme="dark"] .diagram-container {
        --d12-surface: #1e1e1e;
        --d12-border: rgba(255, 255, 255, 0.12);
        --d12-accent: #2f80ed;
        --d12-muted-text: #a0a0a0;
        --d12-text: #e8e8e8;
        --d12-board-text: #e8e8e8;
        --d12-board-fill: #2e2e2e;
        --d12-board-stroke: #8a8a8a;
        --d12-alignment-guide: #ff5c97;
    }

    .diagram-canvas {
        position: absolute;
        inset: 0;
        cursor: grab;
    }

    .diagram-canvas:focus {
        outline: none;
    }

    .diagram-canvas:active {
        cursor: grabbing;
    }

    .drag-over-affordance {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 0 3px #4a90d9;
        background-color: rgba(74, 144, 217, 0.08);
        pointer-events: none;
    }

    .marquee-select {
        position: absolute;
        border: 1px dashed var(--d12-accent);
        background-color: color-mix(in srgb, var(--d12-accent) 8%, transparent);
        pointer-events: none;
    }

    .selection-bounding-box {
        position: absolute;
        border: 1px solid #2f80ed;
        pointer-events: auto;
    }

    .entered-group-outline {
        position: absolute;
        box-sizing: border-box;
        border: 1px dashed var(--d12-muted-text);
        pointer-events: none;
    }

    .group-tab-stop,
    .edge-tab-stop {
        position: absolute;
        pointer-events: none;
    }

    .group-tab-stop:focus,
    .edge-tab-stop:focus {
        outline: none;
    }

    .component-container:focus-visible:not([aria-selected="true"]),
    .group-tab-stop:focus-visible:not([aria-selected="true"]),
    .edge-tab-stop:focus-visible:not([aria-selected="true"]) {
        outline: 2px dashed var(--d12-accent);
        outline-offset: 6px;
    }

    .group-resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #2f80ed;
        border-radius: 50%;
        pointer-events: auto;
    }

    .group-resize-handle.top-left {
        top: -5px;
        left: -5px;
        cursor: nwse-resize;
    }

    .group-resize-handle.top {
        top: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .group-resize-handle.top-right {
        top: -5px;
        right: -5px;
        cursor: nesw-resize;
    }

    .group-resize-handle.right {
        top: calc(50% - 5px);
        right: -5px;
        cursor: ew-resize;
    }

    .group-resize-handle.bottom-right {
        bottom: -5px;
        right: -5px;
        cursor: nwse-resize;
    }

    .group-resize-handle.bottom {
        bottom: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .group-resize-handle.bottom-left {
        bottom: -5px;
        left: -5px;
        cursor: nesw-resize;
    }

    .group-resize-handle.left {
        top: calc(50% - 5px);
        left: -5px;
        cursor: ew-resize;
    }

    .edge-band,
    .instance-layer,
    .guide-layer,
    .selection-chrome {
        position: absolute;
        top: 0;
        left: 0;
        isolation: isolate;
    }

    .edges-layer,
    .guide-strokes,
    .chrome-strokes {
        position: absolute;
        top: 0;
        left: 0;
        width: 1px;
        height: 1px;
        overflow: visible;
        pointer-events: none;
    }

    .edge-line {
        fill: none;
        stroke: #4a4a4a;
        stroke-width: 2;
    }

    .edge-hit {
        fill: none;
        stroke: transparent;
        stroke-width: calc(var(--d12-edge-hit-band) / var(--d12-scale));
        pointer-events: stroke;
        cursor: pointer;
    }

    .edge-line.selected {
        stroke: #2f80ed;
        stroke-width: 3;
    }

    .edge-arrowhead {
        fill: #4a4a4a;
    }

    .edge-arrowhead.selected {
        fill: #2f80ed;
    }

    .edge-label {
        position: absolute;
        cursor: default;
    }

    .alignment-guide,
    .spacing-guide {
        stroke: var(--d12-alignment-guide);
        stroke-opacity: 0.5;
        stroke-width: 1;
    }

    .connector-drag-preview {
        stroke: var(--d12-connector-preview);
        stroke-width: 2;
        stroke-dasharray: 6 4;
    }

    .floating-endpoint {
        fill: #f39c12;
        stroke: #ffffff;
        stroke-width: 1.5px;
        pointer-events: auto;
        cursor: grab;
    }

    .lod-placeholder {
        position: absolute;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        color: var(--d12-muted-text);
    }

    .lod-placeholder-icon {
        font-size: 16px;
        line-height: 1;
    }

    .lod-placeholder-label {
        max-width: 100%;
        padding: 0 2px;
        overflow: hidden;
        font-size: 10px;
        line-height: 1.2;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .canvas-content {
        position: absolute;
        top: 0;
        left: 0;
        transform-origin: top left;
    }

    .grid-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        background: var(--d12-surface);
    }

    .grid-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        background-color: var(--d12-surface);
        background-image:
            linear-gradient(to right, var(--d12-border) 1px, transparent 1px),
            linear-gradient(to bottom, var(--d12-border) 1px, transparent 1px);
    }
</style>

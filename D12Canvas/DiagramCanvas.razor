@namespace D12Canvas

@page "/diagram"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using D12Canvas
@using D12Canvas.Model
@using D12Canvas.Registration
@using System.Collections.Generic;

<div class="diagram-container" @ref="ContainerElement">
    <div class="@CanvasCssClass"
         @onmousedown="@HandleMouseDown"
         @onmousemove="@HandleMouseMove"
         @onmouseup="@HandleMouseUp"
         @onwheel="@HandleMouseWheel"
         @onclick="@HandleCanvasClick"
         @ondragenter="@HandleDragEnterOrOver" @ondragenter:preventDefault="true"
         @ondragover="@HandleDragEnterOrOver" @ondragover:preventDefault="true"
         @ondragleave="@HandleDragLeave"
         @ondrop="@HandleDrop" @ondrop:preventDefault="true">
        <div class="canvas-content" style="@ContentStyle">
            <CascadingValue Value="this" Name="ParentCanvas">
            @if (Board is not null)
            {
                @foreach (var instance in VisibleComponents)
                {
                    var registration = Registry.Resolve(instance.ComponentTypeKey);
                    var effectiveBounds = EffectiveBounds(instance);
                    <ComponentContainer @key="instance.Id"
                                        X="effectiveBounds.X"
                                        Y="effectiveBounds.Y"
                                        Width="effectiveBounds.Width"
                                        Height="effectiveBounds.Height"
                                        ZIndex="instance.ZIndex"
                                        AccessibleName="@registration.AccessibleName"
                                        Role="@registration.Role"
                                        IsSelected="@IsSelected(instance.Id)"
                                        IsMultiSelected="@IsMultiSelected(instance.Id)"
                                        OnSelect="@((shiftKey) => SelectComponent(instance.Id, shiftKey))"
                                        OnMoved="@((bounds) => MoveComponent(instance.Id, bounds))"
                                        OnResized="@((bounds) => ResizeComponent(instance.Id, bounds))">
                        <DynamicComponent Type="registration.ComponentType" Parameters="GetComponentParameters(instance)" />
                    </ComponentContainer>
                }
            }
            @if (_isMarqueeSelecting)
            {
                <div class="marquee-select" style="@MarqueeStyle"></div>
            }
            @if (_selectedInstanceIds.Count > 1)
            {
                <div class="selection-bounding-box" style="@SelectionBoundingBoxStyle">
                    @* Each handle stops both mousedown (so it arms this gesture instead of the
                       canvas's own pan/marquee/group-move) and click (so a stationary press-release
                       with no movement in between - which never sets _dragMoved - doesn't bubble to
                       HandleCanvasClick and wipe the very selection this box belongs to). *@
                    <div class="group-resize-handle top-left" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.TopLeft))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle top" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Top))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle top-right" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.TopRight))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle right" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Right))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle bottom-right" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.BottomRight))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle bottom" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Bottom))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle bottom-left" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.BottomLeft))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle left" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Left))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                </div>
            }
            @ChildContent
            </CascadingValue>
        </div>
    </div>
    @if (_isDragOverBoard)
    {
        <div class="drag-over-affordance"></div>
    }
</div>

<style>
    .diagram-container {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-rows: minmax(400px, auto) minmax(400px, 100%);
        position: relative;
        overflow: hidden;
        border: 1px solid #ccc;
    }
    
    .diagram-canvas {
        width: 100%;
        height: 100%;
        grid-row: 1;
        position: relative;
        cursor: grab;
    }
    
    .diagram-canvas:active {
        cursor: grabbing;
    }

    /* A styled sibling element - not a box-shadow/outline on .diagram-canvas itself, and not
       nested inside it either. .canvas-content is an opaque, oversized (3000x3000)
       absolutely-positioned child that paints over any decoration on .diagram-canvas's own box,
       so a decoration there never reads. Placed instead as a sibling of .diagram-canvas directly
       in .diagram-container (the grid container): as an absolutely-positioned grid item with no
       explicit grid-row/column, it sizes against the container's full padding box rather than
       .diagram-canvas's own row track (whose CSS Grid "auto" sizing collapses toward the 400px
       minimum, since .diagram-canvas has no in-flow content of its own to size the track by). */
    .drag-over-affordance {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 0 3px #4a90d9;
        background-color: rgba(74, 144, 217, 0.08);
        pointer-events: none;
    }

    .marquee-select {
        position: absolute;
        border: 1px dashed #2f80ed;
        background-color: rgba(47, 128, 237, 0.08);
        pointer-events: none;
    }

    /* Ticket 33: the multi-selection's combined bounding box. The box itself lets clicks/drags
       pass through to whatever's underneath (a member's own body, or empty canvas) - only its own
       8 handles (each individually re-enabling pointer-events) are directly interactive. */
    .selection-bounding-box {
        position: absolute;
        border: 1px solid #2f80ed;
        pointer-events: none;
    }

    .group-resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #2f80ed;
        border-radius: 50%;
        pointer-events: auto;
    }

    .group-resize-handle.top-left {
        top: -5px;
        left: -5px;
        cursor: nwse-resize;
    }

    .group-resize-handle.top {
        top: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .group-resize-handle.top-right {
        top: -5px;
        right: -5px;
        cursor: nesw-resize;
    }

    .group-resize-handle.right {
        top: calc(50% - 5px);
        right: -5px;
        cursor: ew-resize;
    }

    .group-resize-handle.bottom-right {
        bottom: -5px;
        right: -5px;
        cursor: nwse-resize;
    }

    .group-resize-handle.bottom {
        bottom: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .group-resize-handle.bottom-left {
        bottom: -5px;
        left: -5px;
        cursor: nesw-resize;
    }

    .group-resize-handle.left {
        top: calc(50% - 5px);
        left: -5px;
        cursor: ew-resize;
    }

    .canvas-content {
        position: absolute;
        top: 0;
        left: 0;
        transform-origin: top left;
        transition: transform 0.1s ease-out;
        background: #f0f0f0;
        background-image: 
            linear-gradient(to right, rgba(0,0,0,0.1) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(0,0,0,0.1) 1px, transparent 1px);
        background-size: 20px 20px;
        background-position: 0 0;
    }
</style>

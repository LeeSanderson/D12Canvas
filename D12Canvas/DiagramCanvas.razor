@namespace D12Canvas

@page "/diagram"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using D12Canvas
@using D12Canvas.Model
@using D12Canvas.Registration
@using System.Collections.Generic;

<div class="diagram-container" @ref="ContainerElement">
    <div class="@CanvasCssClass"
         @onmousedown="@HandleMouseDown"
         @onmousemove="@HandleMouseMove"
         @onmouseup="@HandleMouseUp"
         @onwheel="@HandleMouseWheel"
         @onclick="@HandleCanvasClick"
         @oncontextmenu="@HandleContextMenu" @oncontextmenu:preventDefault="@HasContextMenuEligibleSelection"
         @ondragenter="@HandleDragEnterOrOver" @ondragenter:preventDefault="true"
         @ondragover="@HandleDragEnterOrOver" @ondragover:preventDefault="true"
         @ondragleave="@HandleDragLeave"
         @ondrop="@HandleDrop" @ondrop:preventDefault="true">
        <div class="canvas-content" style="@ContentStyle">
            <CascadingValue Value="this" Name="ParentCanvas">
            <svg class="edges-layer">
                @if (Board is not null)
                {
                    @* Ticket 52: one pair of arrowhead markers per selection state (not per edge) -
                       orient="auto-start-reverse" lets the same marker point correctly whether
                       it's used as marker-start or marker-end. Gated on there being at least one
                       edge (rather than unconditional) so a board with none renders byte-identical
                       markup to before this ticket - every other visual test's own baseline
                       already depends on that (ticket 50's own comment: any edit to this shared
                       markup/CSS re-triggers every Playwright HTML snapshot). *@
                    if (Board.Edges.Count > 0)
                    {
                        <defs>
                            <marker id="edge-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrowhead" />
                            </marker>
                            <marker id="edge-arrow-selected" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" class="edge-arrowhead selected" />
                            </marker>
                        </defs>
                    }
                    @foreach (var edge in Board.Edges)
                    {
                        if (!IsBeingEdited(edge.Id))
                        {
                            var line = EdgeLine(edge);
                            if (line is not null)
                            {
                                var markerStart = EdgeMarkerUrl(edge.SourceArrow, IsEdgeSelected(edge.Id));
                                var markerEnd = EdgeMarkerUrl(edge.TargetArrow, IsEdgeSelected(edge.Id));
                                if (edge.RoutingStyle == EdgeRouting.Straight)
                                {
                                    <line @key="edge.Id" x1="@line.Value.From.X" y1="@line.Value.From.Y" x2="@line.Value.To.X" y2="@line.Value.To.Y"
                                      class="@EdgeLineCssClass(edge.Id)"
                                      marker-start="@markerStart"
                                      marker-end="@markerEnd"
                                      aria-selected="@(IsEdgeSelected(edge.Id) ? "true" : null)"
                                      @onclick="@(() => SelectEdge(edge.Id))"
                                      @onclick:stopPropagation
                                      @ondblclick="@(() => AddEdgeLabel(edge.Id))"
                                      @ondblclick:stopPropagation />
                                }
                                else
                                {
                                    <path @key="edge.Id" d="@EdgePathD(edge.RoutingStyle, line.Value.From, line.Value.To)"
                                      class="@EdgeLineCssClass(edge.Id)"
                                      marker-start="@markerStart"
                                      marker-end="@markerEnd"
                                      aria-selected="@(IsEdgeSelected(edge.Id) ? "true" : null)"
                                      @onclick="@(() => SelectEdge(edge.Id))"
                                      @onclick:stopPropagation
                                      @ondblclick="@(() => AddEdgeLabel(edge.Id))"
                                      @ondblclick:stopPropagation />
                                }
                            }
                        }
                    }
                    @* Ticket 49: a draggable marker for each unattached edge endpoint - dropping it
                       on a port attaches that side; dropping a port that already anchors an edge
                       here instead (StartPortDrag) detaches that side back to floating. *@
                    @foreach (var floating in FloatingEndpoints())
                    {
                        <circle @key="@($"{floating.Edge.Id}-{(floating.IsSource ? "source" : "target")}")"
                                cx="@floating.X" cy="@floating.Y" r="6" class="floating-endpoint"
                                @onmousedown="@((e) => StartFloatingEndpointDrag(floating.Edge.Id, floating.IsSource, e))"
                                @onmousedown:stopPropagation></circle>
                    }
                }
                @if (_isConnectingPort)
                {
                    var preview = ConnectPreviewLine();
                    if (preview is not null)
                    {
                        <line x1="@preview.Value.From.X" y1="@preview.Value.From.Y" x2="@preview.Value.To.X" y2="@preview.Value.To.Y" class="connector-drag-preview" />
                    }
                }
            </svg>
            @if (Board is not null)
            {
                @foreach (var instance in VisibleComponents)
                {
                    var registration = Registry.Resolve(instance.ComponentTypeKey);
                    var effectiveBounds = EffectiveBounds(instance);
                    <ComponentContainer @key="instance.Id"
                                        X="effectiveBounds.X"
                                        Y="effectiveBounds.Y"
                                        Width="effectiveBounds.Width"
                                        Height="effectiveBounds.Height"
                                        ZIndex="instance.ZIndex"
                                        AccessibleName="@registration.AccessibleName"
                                        Role="@registration.Role"
                                        IsSelected="@IsSelected(instance.Id)"
                                        IsMultiSelected="@IsMultiSelected(instance.Id)"
                                        Props="instance.Props"
                                        OnSelect="@((shiftKey) => SelectComponent(instance.Id, shiftKey))"
                                        OnMoved="@((bounds) => MoveComponent(instance.Id, bounds))"
                                        OnResized="@((bounds) => ResizeComponent(instance.Id, bounds))"
                                        OnPortDragStart="@((args) => StartPortDrag(instance.Id, args))"
                                        CustomPorts="instance.CustomPorts"
                                        OnAddCustomPort="@((port) => AddCustomPort(instance.Id, port))">
                        @* Ticket 43: lets a text-carrying built-in (Sticky Note, Text) identify
                           itself back to ParentCanvas when committing its own inline WYSIWYG edit -
                           see CommitPropsChange. Harmless for any built-in that doesn't consume it. *@
                        <CascadingValue Value="instance.Id" Name="InstanceId">
                            <DynamicComponent Type="registration.ComponentType" Parameters="GetComponentParameters(instance)" />
                        </CascadingValue>
                    </ComponentContainer>
                }
                @* Ticket 53/ADR 0005: a label is embedded on its Edge, not a Board.Components
                   entry, so it's rendered here directly rather than via VisibleComponents/
                   ComponentContainer (it's never independently selectable, movable, or resizable).
                   Its box is fully live-derived every render (EdgeLabelStyle) - skipped entirely
                   when the edge has no label or its line can't currently be resolved. *@
                @foreach (var edge in Board.Edges)
                {
                    if (EdgeLabelStyle(edge) is { } labelStyle)
                    {
                        var labelRegistration = Registry.Resolve(edge.Label!.ComponentTypeKey);
                        <div @key="@($"{edge.Id}-label")" class="edge-label" style="@labelStyle"
                             @onmousedown:stopPropagation @onclick:stopPropagation>
                            <CascadingValue Value="edge.Label.Id" Name="InstanceId">
                                <DynamicComponent Type="labelRegistration.ComponentType" Parameters="GetComponentParameters(edge.Label)" />
                            </CascadingValue>
                        </div>
                    }
                }
            }
            @if (_isMarqueeSelecting)
            {
                <div class="marquee-select" style="@MarqueeStyle"></div>
            }
            @if (HasMultiMemberSelection)
            {
                <div class="selection-bounding-box" style="@SelectionBoundingBoxStyle">
                    @* Each handle stops both mousedown (so it arms this gesture instead of the
                       canvas's own pan/marquee/group-move) and click (so a stationary press-release
                       with no movement in between - which never sets _dragMoved - doesn't bubble to
                       HandleCanvasClick and wipe the very selection this box belongs to). *@
                    <div class="group-resize-handle top-left" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.TopLeft))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle top" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Top))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle top-right" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.TopRight))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle right" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Right))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle bottom-right" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.BottomRight))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle bottom" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Bottom))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle bottom-left" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.BottomLeft))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                    <div class="group-resize-handle left" @onmousedown="@((e) => StartGroupResize(e, ResizeDirection.Left))" @onmousedown:stopPropagation @onclick:stopPropagation></div>
                </div>
            }
            @ChildContent
            </CascadingValue>
        </div>
    </div>
    @if (_isDragOverBoard)
    {
        <div class="drag-over-affordance"></div>
    }
    @* Ticket 62/ADR 0009: a sibling of .diagram-canvas (like .drag-over-affordance above), not
       nested inside .canvas-content - canvas chrome (CONTEXT.md) must not pan/zoom with board
       content, so its anchor (_contextMenu.X/Y) is plain container-relative pixels, not board space. *@
    @if (_contextMenu is not null)
    {
        <SelectionContextMenu X="_contextMenu.X" Y="_contextMenu.Y"
                               CanGroup="CanGroupSelection" CanUngroup="CanUngroupSelection"
                               OnDelete="@(() => InvokeFromContextMenu(OnDeletePressed))"
                               OnGroup="@(() => InvokeFromContextMenu(OnGroupPressed))"
                               OnUngroup="@(() => InvokeFromContextMenu(OnUngroupPressed))"
                               OnBringToFront="@(() => InvokeFromContextMenu(OnBringToFrontPressed))"
                               OnSendToBack="@(() => InvokeFromContextMenu(OnSendToBackPressed))"
                               OnBringForward="@(() => InvokeFromContextMenu(OnBringForwardPressed))"
                               OnSendBackward="@(() => InvokeFromContextMenu(OnSendBackwardPressed))"
                               OnRequestClose="@CloseContextMenu" />
    }
</div>

<style>
    .diagram-container {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-rows: minmax(400px, auto) minmax(400px, 100%);
        position: relative;
        overflow: hidden;
        border: 1px solid #ccc;
    }
    
    .diagram-canvas {
        width: 100%;
        height: 100%;
        grid-row: 1;
        position: relative;
        cursor: grab;
    }
    
    .diagram-canvas:active {
        cursor: grabbing;
    }

    /* A styled sibling element - not a box-shadow/outline on .diagram-canvas itself, and not
       nested inside it either. .canvas-content is an opaque, oversized (3000x3000)
       absolutely-positioned child that paints over any decoration on .diagram-canvas's own box,
       so a decoration there never reads. Placed instead as a sibling of .diagram-canvas directly
       in .diagram-container (the grid container): as an absolutely-positioned grid item with no
       explicit grid-row/column, it sizes against the container's full padding box rather than
       .diagram-canvas's own row track (whose CSS Grid "auto" sizing collapses toward the 400px
       minimum, since .diagram-canvas has no in-flow content of its own to size the track by). */
    .drag-over-affordance {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 0 3px #4a90d9;
        background-color: rgba(74, 144, 217, 0.08);
        pointer-events: none;
    }

    .marquee-select {
        position: absolute;
        border: 1px dashed #2f80ed;
        background-color: rgba(47, 128, 237, 0.08);
        pointer-events: none;
    }

    /* Ticket 33: the multi-selection's combined bounding box. The box itself lets clicks/drags
       pass through to whatever's underneath (a member's own body, or empty canvas) - only its own
       8 handles (each individually re-enabling pointer-events) are directly interactive. */
    .selection-bounding-box {
        position: absolute;
        border: 1px solid #2f80ed;
        pointer-events: none;
    }

    .group-resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #2f80ed;
        border-radius: 50%;
        pointer-events: auto;
    }

    .group-resize-handle.top-left {
        top: -5px;
        left: -5px;
        cursor: nwse-resize;
    }

    .group-resize-handle.top {
        top: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .group-resize-handle.top-right {
        top: -5px;
        right: -5px;
        cursor: nesw-resize;
    }

    .group-resize-handle.right {
        top: calc(50% - 5px);
        right: -5px;
        cursor: ew-resize;
    }

    .group-resize-handle.bottom-right {
        bottom: -5px;
        right: -5px;
        cursor: nwse-resize;
    }

    .group-resize-handle.bottom {
        bottom: -5px;
        left: calc(50% - 5px);
        cursor: ns-resize;
    }

    .group-resize-handle.bottom-left {
        bottom: -5px;
        left: -5px;
        cursor: nesw-resize;
    }

    .group-resize-handle.left {
        top: calc(50% - 5px);
        left: -5px;
        cursor: ew-resize;
    }

    /* Ticket 48: sits before the component-instance loop in markup order, so at the shared
       default z-index:0 the instances (later in DOM) paint over it - edges tuck behind shapes,
       matching common diagram-tool convention. width/height 100% resolves against
       .canvas-content's own explicit inline px size (ContentStyle), which is expressed directly
       in board-space units - same coordinate system ComponentContainer's own left/top already
       use - so no separate scaling or viewBox is needed for the line coordinates below. */
    .edges-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    /* Ticket 50: unlike the rest of .edges-layer (pointer-events: none), an edge line is always
       clickable so it can be selected - it has no hover-to-reveal affordance the way a port does,
       since the line itself already IS the visible affordance.
       Ticket 52: fill:none matters once Orthogonal/Curved routing renders as an SVG path element -
       an open multi-point path's implied closing segment would otherwise paint a filled wedge (a
       plain SVG line element has no fill concept, so this was never visible before). */
    .edge-line {
        fill: none;
        stroke: #4a4a4a;
        stroke-width: 2;
        pointer-events: auto;
        cursor: pointer;
    }

    /* Ticket 50: the selected-edge affordance - same selection blue as
       .component-container.selected's outline, applied as the line's own stroke since an outline
       doesn't apply to SVG shapes. */
    .edge-line.selected {
        stroke: #2f80ed;
        stroke-width: 3;
    }

    /* Ticket 52: arrowhead fill matching each of .edge-line's two stroke colors - kept as its own
       rule (rather than `fill: context-stroke`) since that CSS Color 4 keyword isn't reliable
       enough yet across the browsers this library targets. */
    .edge-arrowhead {
        fill: #4a4a4a;
    }

    .edge-arrowhead.selected {
        fill: #2f80ed;
    }

    /* Ticket 53: an edge's embedded label (ADR 0005) - a plain absolutely-positioned HTML box in
       the same board-space pixel coordinate system every ComponentContainer already uses, sitting
       alongside (not inside) .edges-layer's SVG since a label is an ordinary DynamicComponent-
       rendered built-in (Text by default), not an SVG shape. */
    .edge-label {
        position: absolute;
        cursor: default;
    }

    .connector-drag-preview {
        stroke: #2ecc71;
        stroke-width: 2;
        stroke-dasharray: 6 4;
    }

    /* Ticket 49: a floating (unattached) edge endpoint. Filled distinctly from both the gray
       edge line and the green port affordance so it doesn't read as either. Always interactive
       (pointer-events overriding the layer's own none, same trick .port uses) since - unlike a
       port - a floating endpoint has no other affordance revealing it can be grabbed. */
    .floating-endpoint {
        fill: #f39c12;
        stroke: #ffffff;
        stroke-width: 1.5px;
        pointer-events: auto;
        cursor: grab;
    }

    .canvas-content {
        position: absolute;
        top: 0;
        left: 0;
        transform-origin: top left;
        transition: transform 0.1s ease-out;
        background: #f0f0f0;
        background-image: 
            linear-gradient(to right, rgba(0,0,0,0.1) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(0,0,0,0.1) 1px, transparent 1px);
        background-size: 20px 20px;
        background-position: 0 0;
    }
</style>

@namespace D12Canvas

<div class="d12-context-menu" role="menu" aria-label="@AriaLabel" tabindex="-1"
     style="@MenuStyle"
     @ref="_menuRef"
     @oncontextmenu:preventDefault>
    @for (var sectionIndex = 0; sectionIndex < Sections.Count; sectionIndex++)
    {
        @if (sectionIndex > 0)
        {
            <div class="d12-context-menu-separator" role="separator"></div>
        }
        @foreach (var row in Sections[sectionIndex])
        {
            <button type="button" class="d12-context-menu-item"
                    role="@(row.Checked is null ? "menuitem" : "menuitemcheckbox")"
                    aria-checked="@CheckedAttribute(row)"
                    @onclick="() => OnInvoke.InvokeAsync(row.Command)">
                @if (HasToggles)
                {
                    <span class="d12-context-menu-check" aria-hidden="true">@(row.Checked == true ? "✓" : "")</span>
                }
                <span class="d12-context-menu-label">@row.Label</span>
                @if (row.Hint is not null)
                {
                    <span class="d12-context-menu-hint" aria-hidden="true">@row.Hint</span>
                }
            </button>
        }
    }
</div>

<style>
    .d12-context-menu {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
        --d12-shadow: rgba(0, 0, 0, 0.15);
        position: absolute;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        width: 224px;
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
        background: var(--d12-surface);
        border: 1px solid var(--d12-border);
        border-radius: 6px;
        padding: 4px;
        box-sizing: border-box;
        box-shadow: 0 2px 8px var(--d12-shadow);
        color: var(--d12-text);
    }

    @@media (prefers-color-scheme: dark) {
        .d12-context-menu {
            --d12-surface: #2a2a2a;
            --d12-border: rgba(255, 255, 255, 0.12);
            --d12-accent: #2f80ed;
            --d12-muted-text: #a0a0a0;
            --d12-text: #e8e8e8;
        }
    }

    .d12-context-menu[data-d12-theme="light"],
    [data-d12-theme="light"] .d12-context-menu {
        --d12-surface: #fff;
        --d12-border: #ccc;
        --d12-accent: #2f80ed;
        --d12-muted-text: #666;
        --d12-text: #212529;
    }

    .d12-context-menu[data-d12-theme="dark"],
    [data-d12-theme="dark"] .d12-context-menu {
        --d12-surface: #2a2a2a;
        --d12-border: rgba(255, 255, 255, 0.12);
        --d12-accent: #2f80ed;
        --d12-muted-text: #a0a0a0;
        --d12-text: #e8e8e8;
    }

    .d12-context-menu:focus {
        outline: none;
    }

    .d12-context-menu-item {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        height: 28px;
        box-sizing: border-box;
        padding: 0 10px;
        border: 1px solid transparent;
        border-radius: 4px;
        background: transparent;
        cursor: pointer;
        text-align: left;
        font: inherit;
        font-size: 13px;
        color: inherit;
    }

    .d12-context-menu-check {
        flex: 0 0 12px;
    }

    .d12-context-menu-label {
        flex: 1 1 auto;
        white-space: nowrap;
    }

    .d12-context-menu-hint {
        flex: 0 0 auto;
        margin-left: 16px;
        white-space: nowrap;
        color: var(--d12-muted-text);
    }

    .d12-context-menu-item:hover {
        background: color-mix(in srgb, var(--d12-border) 25%, var(--d12-surface));
        border-color: var(--d12-border);
    }

    .d12-context-menu-separator {
        flex: 0 0 1px;
        height: 1px;
        margin: 4px 6px;
        background: var(--d12-border);
    }
</style>

@namespace D12Canvas.Demo.Components

<div class="demo-shape" style="border-style: @Props.Outline">@Props.Label</div>

<style>
    .demo-shape {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #5b6b7f;
        border-radius: 4px;
        background: #eef2f7;
        color: #2c3e50;
        font-size: 14px;
    }
</style>

@code {
    [Parameter]
    public DemoShapeProps Props { get; set; } = new("");
}

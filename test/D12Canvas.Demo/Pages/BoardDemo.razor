@page "/board-demo"
@using D12Canvas
@using D12Canvas.BuiltIns
@using D12Canvas.Model
@using D12Canvas.Demo.Components

<PageTitle>Board Demo</PageTitle>

<div class="canvas-container">
    <DiagramCanvas Board="_board" />
</div>

<style>
    .canvas-container {
        height: 600px;
        border: 1px solid #ccc;
    }
</style>

@code {
    // A tiny embedded PNG so the screenshot baseline stays deterministic and offline - no
    // dependency on a real network fetch succeeding inside the visual-test container.
    private const string SampleImageDataUrl =
        "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAAECAYAAACp8Z5+AAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAAASSURBVBhXY3DMfPgfGTOQLgAAUD8ooVtGnUoAAAAASUVORK5CYII=";

    private readonly Board _board = SeedBoard();

    private static Board SeedBoard()
    {
        var board = new Board();
        board.AddComponent(
            new ComponentInstance(
                "demo-note",
                new DemoNoteProps("Welcome to D12Canvas", "#ffd966"),
                new Bounds(120, 80, 220, 140),
                zIndex: 1
            )
        );
        board.AddComponent(
            new ComponentInstance(
                "demo-note",
                new DemoNoteProps("Rendered from a seeded Board", "#a3d9a5"),
                new Bounds(420, 220, 220, 140),
                zIndex: 2
            )
        );
        board.AddComponent(
            new ComponentInstance(
                "demo-note",
                new DemoNoteProps("Resolved through the component registry", "#9ec5fe"),
                new Bounds(220, 340, 240, 140),
                zIndex: 0
            )
        );
        board.AddComponent(
            new ComponentInstance(
                "rectangle",
                new RectangleProps("#e3f2fd", "#1565c0", 3),
                new Bounds(700, 120, 160, 100),
                zIndex: 3
            )
        );
        board.AddComponent(
            new ComponentInstance(
                "sticky-note",
                new StickyNoteProps("Sticky note built-in", "#FFEB3B", "#000000", 14),
                new Bounds(700, 260, 200, 200),
                zIndex: 4
            )
        );
        board.AddComponent(
            new ComponentInstance(
                "text",
                new TextProps("Text built-in", "#1565c0", 20, "bold", "center"),
                new Bounds(700, 480, 200, 40),
                zIndex: 5
            )
        );
        board.AddComponent(
            new ComponentInstance(
                "image",
                new ImageProps(SampleImageDataUrl, "Image built-in", "cover"),
                new Bounds(460, 20, 240, 180),
                zIndex: 6
            )
        );
        return board;
    }
}

@page "/board/{Id:guid}"
@implements IDisposable
@using D12Canvas
@using D12Canvas.App.Storage
@using D12Canvas.App.Suggestions
@using D12Canvas.Model
@inject IBoardStore BoardStore
@inject NavigationManager Navigation

<PageTitle>@(_name ?? "Board")</PageTitle>

<div class="board-editor-page" data-d12-theme="@ThemeAttribute">
    <div class="board-editor-header">
        <button class="btn btn-secondary btn-sm" @onclick="GoBack">&larr; Boards</button>

        @if (_isEditingName)
        {
            <input
                class="board-title-input"
                @ref="_titleInputRef"
                value="@_nameDraft"
                @oninput="args => _nameDraft = args.Value?.ToString() ?? string.Empty"
                @onkeydown="HandleTitleKeyDown"
                @onblur="CommitRenameTitle"
            />
        }
        else
        {
            <h1 class="board-title" @onclick="StartRenameTitle" title="Click to rename">@_name</h1>
        }

        <label class="autosave-toggle">
            <input type="checkbox" @bind="_autosaveEnabled" />
            Autosave
        </label>
        <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@(!_isDirty)">Save</button>
    </div>

    <div class="board-editor-toolbar">
        <div class="board-editor-group">
            <button class="btn btn-secondary btn-sm" title="Ctrl+Z" @onclick="Undo">Undo</button>
            <button class="btn btn-secondary btn-sm" title="Ctrl+Shift+Z" @onclick="Redo">Redo</button>
        </div>

        <div class="board-editor-group">
            <button class="btn btn-secondary btn-sm" title="Shift+1" @onclick="ZoomToFit">Fit</button>
            <button class="btn btn-secondary btn-sm" title="Shift+2" @onclick="ZoomToSelection">Selection</button>
            <button class="btn btn-secondary btn-sm" title="Shift+0" @onclick="ZoomTo100Percent">100%</button>
        </div>

        <div class="board-editor-group">
            <label title="Ctrl+'"><input type="checkbox" @bind="_snapToGrid" /> Snap to grid</label>
            <label><input type="checkbox" @bind="_objectSnapping" /> Object snapping</label>
        </div>

        <div class="board-editor-group">
            <label>
                Wheel
                <select @bind="_wheelProfile">
                    <option value="@WheelDeviceProfile.Auto">Auto</option>
                    <option value="@WheelDeviceProfile.Mouse">Mouse</option>
                    <option value="@WheelDeviceProfile.Trackpad">Trackpad</option>
                </select>
            </label>
            <label>
                Theme
                <select @bind="_theme">
                    <option value="system">System</option>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>
            </label>
        </div>

        <div class="board-editor-group">
            <button class="btn btn-secondary btn-sm" @onclick="ToggleShortcuts" aria-expanded="@_showShortcuts">
                Shortcuts
            </button>
            <button class="btn btn-primary btn-sm" @onclick="OpenSuggestionBox">Suggest…</button>
            @if (_savedSuggestion is not null)
            {
                <span class="board-editor-saved" role="status">Saved @_savedSuggestion</span>
            }
        </div>

        <span class="board-editor-status">@_selectedCount selected · <ZoomReadout Canvas="_canvas" /></span>
    </div>

    <SuggestionBox @ref="_suggestionBox" OnSaved="HandleSuggestionSaved" />

    @if (_board is not null)
    {
        <div class="board-editor-body">
            <DiagramCanvas
                @ref="_canvas"
                Board="_board"
                @bind-SnapToGrid="_snapToGrid"
                @bind-ObjectSnapping="_objectSnapping"
                WheelDeviceProfile="_wheelProfile"
            />
            <div class="board-editor-overlay board-editor-palette">
                <Palette Canvas="_canvas" />
            </div>
            @if (_selectedCount > 0)
            {
                <div class="board-editor-overlay board-editor-properties">
                    <PropertyPanel Canvas="_canvas" />
                </div>
            }
            <div class="board-editor-overlay board-editor-minimap">
                <Minimap Canvas="_canvas" />
            </div>
            @if (_showShortcuts)
            {
                <div class="board-editor-overlay board-editor-shortcuts">
                    @foreach (var (heading, rows) in Shortcuts)
                    {
                        <h2>@heading</h2>
                        <dl>
                            @foreach (var (keys, action) in rows)
                            {
                                <dt>@keys</dt>
                                <dd>@action</dd>
                            }
                        </dl>
                    }
                </div>
            }
        </div>
    }
    else if (_notFound)
    {
        <p role="alert">No board found with that id.</p>
    }
</div>

<style>
    .board-editor-page {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--app-bg);
        color: var(--app-text);
    }

    .board-editor-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 10px 16px;
        background: var(--app-surface);
        border-bottom: 1px solid var(--app-border);
    }

    .board-title,
    .board-title-input {
        flex: 1;
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--app-text);
    }

    .board-title {
        padding: 4px 8px;
        border-radius: var(--app-radius-sm);
        cursor: pointer;
    }

    .board-title:hover {
        background: var(--app-bg);
    }

    .board-title-input {
        padding: 3px 7px;
        font-family: inherit;
        border: 1px solid var(--app-accent);
        border-radius: var(--app-radius-sm);
        background: var(--app-surface);
        outline: none;
    }

    .autosave-toggle {
        display: flex;
        align-items: center;
        gap: 4px;
        color: var(--app-muted-text);
        font-size: 0.9rem;
    }

    .board-editor-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 20px;
        padding: 6px 16px;
        background: var(--app-surface);
        border-bottom: 1px solid var(--app-border);
        color: var(--app-muted-text);
        font-size: 0.9rem;
    }

    .board-editor-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .board-editor-group label {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .board-editor-saved {
        color: var(--app-success);
    }

    .board-editor-status {
        margin-left: auto;
        font-variant-numeric: tabular-nums;
    }

    .board-editor-body {
        flex: 1;
        min-height: 0;
        position: relative;
    }

    .board-editor-overlay {
        position: absolute;
        top: 12px;
        z-index: 10;
        max-height: calc(100% - 24px);
        overflow-y: auto;
        box-shadow: var(--app-shadow);
    }

    .board-editor-palette {
        left: 12px;
        width: 180px;
        border-radius: 6px;
    }

    .board-editor-minimap {
        top: auto;
        bottom: 12px;
        right: 12px;
        width: 200px;
        height: 140px;
        overflow: hidden;
        border-radius: 6px;
    }

    .board-editor-properties {
        right: 12px;
        max-height: calc(100% - 176px);
        width: 260px;
        box-sizing: border-box;
        padding: 12px;
        background: var(--app-surface);
        border: 1px solid var(--app-border);
        border-radius: var(--app-radius-sm);
    }
    .board-editor-shortcuts {
        left: 204px;
        width: 340px;
        box-sizing: border-box;
        padding: 12px 16px;
        background: var(--app-surface);
        border: 1px solid var(--app-border);
        border-radius: var(--app-radius-sm);
        font-size: 0.85rem;
    }

    .board-editor-shortcuts h2 {
        margin: 10px 0 4px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--app-muted-text);
    }

    .board-editor-shortcuts h2:first-child {
        margin-top: 0;
    }

    .board-editor-shortcuts dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 2px 12px;
        margin: 0;
    }

    .board-editor-shortcuts dt {
        font-weight: 600;
        white-space: nowrap;
    }

    .board-editor-shortcuts dd {
        margin: 0;
    }
</style>

@code {
    private static readonly TimeSpan AutosaveDebounce = TimeSpan.FromSeconds(1);

    private static readonly (string Heading, (string Keys, string Action)[] Rows)[] Shortcuts =
    [
        ("Pointer", [
            ("Drag on empty canvas", "Marquee select"),
            ("Double-click", "Enter a group, then edit"),
            ("Alt+drag", "Clone the selection"),
            ("Alt+resize", "Resize from the centre"),
            ("Shift+drag", "Move in a straight line"),
            ("Click a port", "Duplicate and connect"),
            ("Right- or middle-drag", "Pan"),
            ("Right-click", "Context menu"),
            ("Wheel", "Zoom, or pan on a trackpad"),
        ]),
        ("Keyboard", [
            ("Tab", "Move between shapes"),
            ("Space", "Add the focused shape to the selection"),
            ("Enter / Escape", "Enter / leave a group"),
            ("F2", "Edit text"),
            ("Arrows", "Nudge"),
            ("Ctrl+Arrow", "Duplicate and connect"),
            ("Ctrl+Shift+Arrow", "Focus the nearest shape"),
            ("Shift+F10", "Context menu"),
            ("Ctrl+Enter", "Focus the property bar"),
        ]),
        ("Commands", [
            ("Ctrl+Z / Ctrl+Shift+Z", "Undo / redo"),
            ("Ctrl+C / X / V", "Copy / cut / paste"),
            ("Ctrl+D", "Duplicate"),
            ("Ctrl+A", "Select all"),
            ("Delete", "Delete"),
            ("Ctrl+G / Ctrl+Shift+G", "Group / ungroup"),
            ("Ctrl+Shift+L", "Lock or unlock"),
            ("Ctrl+] / Ctrl+[", "Forward / backward"),
            ("Ctrl+Shift+] / [", "To front / to back"),
            ("Ctrl+'", "Snap to grid"),
            ("PageUp / PageDown", "Zoom in / out"),
            ("Shift+1 / 2 / 0", "Fit / selection / 100%"),
        ]),
    ];

    [Parameter]
    public Guid Id { get; set; }

    private Board? _board;
    private string? _name;
    private bool _notFound;
    private DiagramCanvas? _canvas;
    private DiagramCanvas? _subscribedCanvas;
    private bool _isDirty;
    private int _selectedCount;
    private bool _snapToGrid = true;
    private bool _objectSnapping = true;
    private string _theme = "system";
    private bool _showShortcuts;
    private SuggestionBox? _suggestionBox;
    private string? _savedSuggestion;
    private bool _autosaveEnabled;
    private WheelDeviceProfile _wheelProfile = WheelDeviceProfile.Auto;
    private CancellationTokenSource? _autosaveCts;
    private bool _isEditingName;
    private string _nameDraft = "";
    private bool _focusTitleInputPending;
    private ElementReference _titleInputRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await BoardStore.LoadAsync(Id);
            _board = saved.Board;
            _name = saved.Name;
        }
        catch (BoardNotFoundException)
        {
            _notFound = true;
        }
    }

    // DiagramCanvas is only rendered once _board finishes loading, so its @ref isn't captured
    // until a render after this page's own first one - re-checked on every render (cheap: a
    // reference comparison) rather than gated to firstRender, the same "subscribe once the
    // reference actually changes" shape PropertyPanel uses for its own Canvas parameter. @ref is
    // only assigned after the render that produced it, so Palette's own Canvas parameter is still
    // stale (null) on the render where _canvas is first captured (same wrinkle
    // PropertyPanelDemo's own layout documents) - the extra StateHasChanged forces the one more
    // render pass Palette needs to pick up the now-non-null reference.
    protected override void OnAfterRender(bool firstRender)
    {
        if (_focusTitleInputPending)
        {
            _focusTitleInputPending = false;
            _ = _titleInputRef.FocusAsync();
        }

        if (ReferenceEquals(_subscribedCanvas, _canvas))
        {
            return;
        }

        if (_subscribedCanvas is not null)
        {
            _subscribedCanvas.Changed -= HandleBoardChanged;
            _subscribedCanvas.SelectionChanged -= HandleSelectionChanged;
        }

        _subscribedCanvas = _canvas;

        if (_subscribedCanvas is not null)
        {
            _subscribedCanvas.Changed += HandleBoardChanged;
            _subscribedCanvas.SelectionChanged += HandleSelectionChanged;
        }

        StateHasChanged();
    }

    private string? ThemeAttribute => _theme == "system" ? null : _theme;

    private void HandleSelectionChanged(object? sender, EventArgs e)
    {
        _selectedCount = (_canvas?.SelectedComponents.Count ?? 0) + (_canvas?.SelectedEdges.Count ?? 0);
        StateHasChanged();
    }

    private void Undo() => _canvas?.OnUndoPressed();

    private void Redo() => _canvas?.OnRedoPressed();

    private void ZoomToFit() => _canvas?.ZoomToFit();

    private void ZoomToSelection() => _canvas?.ZoomToSelection();

    private void ZoomTo100Percent() => _canvas?.ZoomTo100Percent();

    private void ToggleShortcuts() => _showShortcuts = !_showShortcuts;

    private async Task OpenSuggestionBox()
    {
        _savedSuggestion = null;
        if (_suggestionBox is not null)
        {
            await _suggestionBox.OpenAsync();
        }
    }

    private void HandleSuggestionSaved(SavedSuggestion saved) => _savedSuggestion = saved.Markdown;

    private void HandleBoardChanged(object? sender, EventArgs e)
    {
        _isDirty = true;
        StateHasChanged();

        if (_autosaveEnabled)
        {
            ScheduleAutosave();
        }
    }

    // Coalesces a burst of rapid gestures (several quick nudges) into a single save: each new
    // Changed firing cancels whatever autosave was already pending and starts the debounce over.
    private void ScheduleAutosave()
    {
        _autosaveCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autosaveCts = cts;
        _ = RunDebouncedAutosave(cts.Token);
    }

    private async Task RunDebouncedAutosave(CancellationToken token)
    {
        try
        {
            await Task.Delay(AutosaveDebounce, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(Save);
    }

    private async Task Save()
    {
        if (_board is not null)
        {
            await BoardStore.SaveAsync(Id, _board);
            _isDirty = false;
            StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private void StartRenameTitle()
    {
        if (_board is null)
        {
            return;
        }

        _nameDraft = _name ?? "";
        _isEditingName = true;
        _focusTitleInputPending = true;
    }

    private async Task CommitRenameTitle()
    {
        if (!_isEditingName)
        {
            return;
        }

        _isEditingName = false;
        var trimmed = _nameDraft.Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || trimmed == _name)
        {
            return;
        }

        _name = trimmed;
        await BoardStore.RenameAsync(Id, trimmed);
    }

    private void CancelRenameTitle()
    {
        _isEditingName = false;
        _nameDraft = _name ?? "";
    }

    private async Task HandleTitleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await CommitRenameTitle();
                break;
            case "Escape":
                CancelRenameTitle();
                break;
        }
    }

    public void Dispose()
    {
        _autosaveCts?.Cancel();
        if (_subscribedCanvas is not null)
        {
            _subscribedCanvas.Changed -= HandleBoardChanged;
            _subscribedCanvas.SelectionChanged -= HandleSelectionChanged;
        }
    }
}

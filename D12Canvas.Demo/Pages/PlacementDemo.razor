@page "/placement-demo"
@using D12Canvas
@using D12Canvas.Model

<PageTitle>Placement Demo</PageTitle>

<div class="placement-demo-layout">
    <div class="palette-slot">
        <Palette Canvas="_canvas" />
    </div>
    <div class="canvas-container">
        <DiagramCanvas @ref="_canvas" Board="_board" />
    </div>
</div>

<style>
    .placement-demo-layout {
        display: flex;
        gap: 16px;
    }

    .palette-slot {
        width: 260px;
        padding: 16px;
    }

    .canvas-container {
        flex: 1;
        height: 600px;
        border: 1px solid #ccc;
    }
</style>

@code {
    private DiagramCanvas? _canvas;
    private readonly Board _board = new();

    // DiagramCanvas is declared after Palette in the markup above, so its @ref isn't captured
    // until after Palette has already received its first (null) Canvas parameter. Forcing one
    // extra render pass lets Palette pick up the now-non-null reference.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
    }
}

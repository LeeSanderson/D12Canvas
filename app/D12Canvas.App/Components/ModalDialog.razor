@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog
    @ref="_dialog"
    class="modal app-dialog"
    aria-labelledby="@LabelledBy"
    @onclose="() => OnClose.InvokeAsync()"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @ChildContent
        </div>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public string LabelledBy { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference _dialog;
    private LazyJsModule _module = null!;

    public ElementReference Element => _dialog;

    protected override void OnInitialized() => _module = new(JS, "./Components/ModalDialog.razor.js");

    public async Task ShowAsync() => await (await _module.GetAsync()).InvokeVoidAsync("showModal", _dialog);

    public async Task CloseAsync() => await (await _module.GetAsync()).InvokeVoidAsync("close", _dialog);

    public ValueTask DisposeAsync() => _module.DisposeAsync();
}

@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog
    @ref="_dialog"
    class="modal app-dialog"
    aria-labelledby="@LabelledBy"
    @onclose="() => OnClose.InvokeAsync()"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @ChildContent
        </div>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public string LabelledBy { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;

    public ElementReference Element => _dialog;

    public async Task ShowAsync() => await (await ModuleAsync()).InvokeVoidAsync("showModal", _dialog);

    public async Task CloseAsync() => await (await ModuleAsync()).InvokeVoidAsync("close", _dialog);

    private async Task<IJSObjectReference> ModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/ModalDialog.razor.js");

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}

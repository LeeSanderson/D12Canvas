@implements IAsyncDisposable
@using System.Net
@using System.Net.Http.Json
@using D12Canvas.App.Shared.Suggestions
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<ModalDialog @ref="_dialog" LabelledBy="suggestion-box-heading" OnClose="StateHasChanged">
    <div class="modal-header">
        <h2 class="modal-title fs-5" id="suggestion-box-heading">Suggest a feature or change</h2>
    </div>

    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label" for="suggestion-box-title">Title</label>
            <input
                id="suggestion-box-title"
                class="form-control"
                type="text"
                autofocus
                maxlength="@MaxTitleLength"
                placeholder="What should change?"
                @bind="_title"
                @bind:event="oninput"
            />
        </div>

        <div class="mb-3">
            <label class="form-label" for="suggestion-box-details">Details</label>
            <textarea
                id="suggestion-box-details"
                class="form-control"
                rows="5"
                placeholder="Optional: what you expected, what happened, why it matters"
                @bind="_details"
                @bind:event="oninput"
            ></textarea>
        </div>

        <div class="suggestion-box-screenshot">
            @if (_screenshot is null)
            {
                <span>Paste a screenshot with Ctrl+V while this box is open.</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PasteFromClipboard">
                    Paste from clipboard
                </button>
            }
            else
            {
                <img src="@_screenshot" alt="Pasted screenshot" />
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RemoveScreenshot">
                    Remove screenshot
                </button>
            }
        </div>

        @if (_message is not null)
        {
            <p class="text-danger small mt-3 mb-0" role="alert">@_message</p>
        }
    </div>

    <div class="modal-footer">
        <span class="text-body-secondary small me-auto">Ctrl+Enter saves</span>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAsync">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanSave)" @onclick="SaveAsync">
            @(_saving ? "Saving…" : "Save")
        </button>
    </div>
</ModalDialog>

<style>
    .suggestion-box-screenshot {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 12px;
        border: 1px dashed var(--bs-border-color);
        border-radius: var(--bs-border-radius);
        color: var(--bs-secondary-color);
        font-size: 0.875rem;
    }

    .suggestion-box-screenshot img {
        max-width: 100%;
        max-height: 240px;
        border: 1px solid var(--bs-border-color);
    }
</style>

@code {
    private const int MaxTitleLength = 120;

    [Parameter]
    public EventCallback<SavedSuggestion> OnSaved { get; set; }

    private ModalDialog? _dialog;
    private DotNetObjectReference<SuggestionBox>? _selfReference;
    private IJSObjectReference? _module;
    private IJSObjectReference? _listener;
    private string _title = "";
    private string _details = "";
    private string? _screenshot;
    private string? _message;
    private bool _saving;

    private bool CanSave => !_saving && !string.IsNullOrWhiteSpace(_title);

    // A closed box keeps its draft, so an accidental Escape loses nothing; only a save clears it.
    public async Task OpenAsync()
    {
        if (_dialog is null)
        {
            return;
        }

        _message = null;
        _listener ??= await AttachAsync(_dialog.Element);
        await _dialog.ShowAsync();
    }

    private async Task<IJSObjectReference> AttachAsync(ElementReference dialog)
    {
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/SuggestionBox.razor.js"
        );
        _selfReference = DotNetObjectReference.Create(this);
        return await _module.InvokeAsync<IJSObjectReference>("attach", dialog, _selfReference);
    }

    [JSInvokable]
    public void OnScreenshotPasted(string dataUrl)
    {
        _screenshot = dataUrl;
        _message = null;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnSaveShortcut() => SaveAsync();

    private async Task PasteFromClipboard()
    {
        var dataUrl = _module is null ? null : await _module.InvokeAsync<string?>("readClipboardImage");
        if (dataUrl is null)
        {
            _message = "No image on the clipboard, or the browser didn't allow reading it. Try Ctrl+V.";
            return;
        }

        OnScreenshotPasted(dataUrl);
    }

    private void RemoveScreenshot() => _screenshot = null;

    private async Task CloseAsync()
    {
        if (_dialog is not null)
        {
            await _dialog.CloseAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _saving = true;
        _message = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/suggestions",
                new SuggestionSubmission(_title, _details, _screenshot, "/" + Navigation.ToBaseRelativePath(Navigation.Uri))
            );

            if (response.IsSuccessStatusCode)
            {
                var saved = await response.Content.ReadFromJsonAsync<SavedSuggestion>();
                _title = "";
                _details = "";
                _screenshot = null;
                await CloseAsync();
                await OnSaved.InvokeAsync(saved);
            }
            else if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _message = await response.Content.ReadFromJsonAsync<string>();
            }
            else
            {
                _message = ServerMissingMessage;
            }
        }
        catch (HttpRequestException)
        {
            _message = ServerMissingMessage;
        }
        finally
        {
            _saving = false;
        }
    }

    private const string ServerMissingMessage =
        "Couldn't save. Suggestions are written by D12Canvas.App.Api: start the App and the API together with `dotnet run --project app/D12Canvas.AppHost`.";

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_listener is not null)
            {
                await _listener.InvokeVoidAsync("dispose");
                await _listener.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }

        _selfReference?.Dispose();
    }
}

<ModalDialog @ref="_dialog" LabelledBy="rename-board-title" OnClose="Cancel">
    <form @onsubmit="Confirm">
        <div class="modal-header">
            <h2 class="modal-title fs-5" id="rename-board-title">Rename board</h2>
        </div>
        <div class="modal-body">
            <input
                class="form-control"
                aria-label="Board name"
                autofocus
                value="@_value"
                @oninput="args => _value = args.Value?.ToString() ?? string.Empty"
            />
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_value)">
                Rename
            </button>
        </div>
    </form>
</ModalDialog>

@code {
    [Parameter, EditorRequired]
    public string InitialName { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private ModalDialog? _dialog;
    private string _value = "";

    protected override void OnInitialized() => _value = InitialName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _dialog is not null)
        {
            await _dialog.ShowAsync();
        }
    }

    private async Task Confirm()
    {
        var trimmed = _value.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        await OnSave.InvokeAsync(trimmed);
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();
}

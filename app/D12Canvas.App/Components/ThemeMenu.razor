@implements IAsyncDisposable
@using D12Canvas.App.Preferences
@inject IPreferences Preferences
@inject IJSRuntime JS

<Dropdown
    ToggleClass="btn btn-link link-body-emphasis btn-sm d-flex align-items-center gap-1 text-decoration-none"
    Title="@($"Theme: {_choice.Label}")"
    MenuClass="dropdown-menu-md-end"
>
    <Toggle><Icon Name="@_choice.Icon" /> Theme</Toggle>
    <ChildContent Context="close">
        @foreach (var choice in ThemeChoice.All)
        {
            <button
                type="button"
                class="dropdown-item d-flex align-items-center gap-2 @(choice == _choice ? "active" : null)"
                aria-pressed="@Aria.Bool(choice == _choice)"
                @onclick="() => Choose(choice, close)"
            >
                <Icon Name="@choice.Icon" /> @choice.Label
            </button>
        }
    </ChildContent>
</Dropdown>

@code {
    private ThemeChoice _choice = ThemeChoice.System;
    private LazyJsModule _module = null!;

    protected override async Task OnInitializedAsync()
    {
        _module = new(JS, "./Components/ThemeMenu.razor.js");
        _choice = ThemeChoice.Parse(await Preferences.GetAsync(PreferenceKeys.Theme));
    }

    private async Task Choose(ThemeChoice choice, Action close)
    {
        _choice = choice;
        close();
        await Preferences.SetAsync(PreferenceKeys.Theme, choice.Value);
        var module = await _module.GetAsync();
        var mode = choice == ThemeChoice.System ? await module.InvokeAsync<string>("systemMode") : choice.Value;
        await module.InvokeVoidAsync("setMode", mode);
    }

    public ValueTask DisposeAsync() => _module.DisposeAsync();
}

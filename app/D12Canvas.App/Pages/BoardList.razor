@page "/"
@using D12Canvas.App.Storage
@inject IBoardStore BoardStore
@inject NavigationManager Navigation
@inject IJSRuntime JS

<AppPageTitle Page="Boards" />

<SectionContent SectionName="@PageHeaderSections.Title">
    <h1 class="fs-5 fw-semibold mb-0">Boards</h1>
</SectionContent>

<SectionContent SectionName="@PageHeaderSections.Actions">
    <button
        type="button"
        class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1"
        @onclick="CreateBoard"
        disabled="@_isCreating"
    >
        <Icon Name="plus-lg" /> New board
    </button>
</SectionContent>

<div class="boards-page">
    <div class="boards-content card shadow-sm overflow-hidden">
        @if (_boards is null)
        {
            <div class="boards-skeleton" aria-hidden="true">
                <div class="skeleton-row"></div>
                <div class="skeleton-row"></div>
                <div class="skeleton-row"></div>
            </div>
        }
        else if (_boards.Count == 0)
        {
            <div class="empty-state">
                <svg
                    class="empty-state-icon"
                    viewBox="0 0 48 48"
                    width="48"
                    height="48"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <rect x="6" y="10" width="36" height="28" rx="4" stroke="currentColor" stroke-width="2" />
                    <path d="M6 18h36" stroke="currentColor" stroke-width="2" />
                    <circle cx="16" cy="28" r="3" stroke="currentColor" stroke-width="2" />
                    <path
                        d="M24 30l4-4 6 6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
                <h2>No boards yet</h2>
                <p>Create your first board to start diagramming.</p>
                <button
                    class="btn btn-primary d-inline-flex align-items-center gap-2"
                    @onclick="CreateBoard"
                    disabled="@_isCreating"
                >
                    <Icon Name="plus-lg" /> New board
                </button>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3" scope="col">Name</th>
                        <th scope="col">Created</th>
                        <th scope="col">Updated</th>
                        <th class="pe-3" scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var board in _boards)
                    {
                        <tr>
                            <td class="ps-3">
                                <button
                                    class="btn btn-link p-0 text-start fw-medium"
                                    @onclick="() => OpenBoard(board.Id)"
                                >
                                    @board.Name
                                </button>
                            </td>
                            <td class="text-body-secondary small">@board.CreatedAt.LocalDateTime.ToString("g")</td>
                            <td class="text-body-secondary small">@board.UpdatedAt.LocalDateTime.ToString("g")</td>
                            <td class="pe-3 text-end">
                                <div class="d-inline-flex gap-2">
                                    <button
                                        class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1"
                                        @onclick="() => StartRename(board)"
                                    >
                                        <Icon Name="pencil" /> Rename
                                    </button>
                                    <button
                                        class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1"
                                        @onclick="() => DeleteBoard(board.Id)"
                                    >
                                        <Icon Name="trash" /> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (_renamingBoard is not null)
{
    <RenameBoardModal InitialName="@_renamingBoard.Name" OnSave="SaveRename" OnCancel="CancelRename" />
}

<style>
    .boards-page {
        max-width: 840px;
        margin: 0 auto;
        padding: 32px 24px;
    }

    .boards-content {
        min-height: 240px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 64px 24px;
        color: var(--bs-secondary-color);
    }

    .empty-state-icon {
        color: var(--bs-secondary-color);
        margin-bottom: 16px;
    }

    .empty-state h2 {
        margin: 0 0 4px;
        color: var(--bs-body-color);
        font-size: 1.1rem;
    }

    .empty-state p {
        margin: 0 0 20px;
    }

    .boards-skeleton {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .skeleton-row {
        height: 44px;
        border-radius: var(--bs-border-radius);
        background: linear-gradient(90deg, var(--bs-tertiary-bg) 25%, var(--bs-border-color) 37%, var(--bs-tertiary-bg) 63%);
        background-size: 400% 100%;
        animation: skeleton-shimmer 1.4s ease infinite;
    }

    @@keyframes skeleton-shimmer {
        0% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }
</style>

@code {
    private const string DefaultBoardName = "Untitled board";

    private IReadOnlyList<BoardSummary>? _boards;
    private bool _isCreating;
    private BoardSummary? _renamingBoard;

    protected override async Task OnInitializedAsync() => await RefreshBoards();

    private async Task RefreshBoards()
    {
        var boards = await BoardStore.ListAsync();
        _boards = boards.OrderByDescending(b => b.UpdatedAt).ToList();
    }

    private async Task CreateBoard()
    {
        if (_isCreating)
        {
            return;
        }

        _isCreating = true;
        try
        {
            var saved = await BoardStore.CreateAsync(DefaultBoardName);
            Navigation.NavigateTo($"/board/{saved.Id}");
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void OpenBoard(Guid id) => Navigation.NavigateTo($"/board/{id}");

    private void StartRename(BoardSummary board) => _renamingBoard = board;

    private void CancelRename() => _renamingBoard = null;

    private async Task SaveRename(string newName)
    {
        if (_renamingBoard is null)
        {
            return;
        }

        await BoardStore.RenameAsync(_renamingBoard.Id, newName);
        _renamingBoard = null;
        await RefreshBoards();
    }

    private async Task DeleteBoard(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Delete this board? This cannot be undone."
        );
        if (!confirmed)
        {
            return;
        }

        await BoardStore.DeleteAsync(id);
        await RefreshBoards();
    }
}

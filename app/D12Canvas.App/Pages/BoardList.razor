@page "/"
@using System.Globalization
@using D12Canvas.App.Storage
@using D12Canvas.Model
@implements IDisposable
@inject IBoardStore BoardStore
@inject NavigationManager Navigation
@inject TimeProvider Clock

<AppPageTitle Page="Boards" />

<SectionContent SectionName="@PageHeaderSections.Title">
    <h1 class="fs-5 fw-semibold mb-0">Boards</h1>
</SectionContent>

<SectionContent SectionName="@PageHeaderSections.Actions">
    <button
        type="button"
        class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1"
        @onclick="CreateBoard"
        disabled="@_isCreating"
    >
        <Icon Name="plus-lg" /> New board
    </button>
</SectionContent>

<div class="container-xl py-4">
    @if (_boards is null)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 placeholder-glow" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="ratio ratio-16x9 placeholder card-img-top"></div>
                        <div class="card-body py-2">
                            <span class="placeholder col-7 d-block mb-2"></span>
                            <span class="placeholder placeholder-sm col-4"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_boards.Count == 0)
    {
        <div class="list-group shadow-sm mx-auto board-empty">
            <div class="list-group-item text-center py-5">
                <span class="d-block fs-1 text-body-tertiary mb-2"><Icon Name="easel" /></span>
                <h2 class="h6 mb-1">No boards yet</h2>
                <p class="text-body-secondary small mb-3">Create your first board to start diagramming.</p>
                <button
                    type="button"
                    class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1"
                    @onclick="CreateBoard"
                    disabled="@_isCreating"
                >
                    <Icon Name="plus-lg" /> New board
                </button>
            </div>
        </div>
    }
    else
    {
        var now = Clock.GetLocalNow();
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
            <div class="col">
                <button
                    type="button"
                    class="card h-100 w-100 board-new-tile text-body-secondary"
                    @onclick="CreateBoard"
                    disabled="@_isCreating"
                >
                    <span class="ratio ratio-16x9">
                        <span class="d-flex flex-column align-items-center justify-content-center gap-2">
                            <span class="fs-2"><Icon Name="plus-lg" /></span>
                            <span class="fw-medium">New board</span>
                        </span>
                    </span>
                </button>
            </div>
            @foreach (var board in _boards)
            {
                <div class="col" @key="board.Id">
                    <div class="card h-100 shadow-sm board-card">
                        <div class="ratio ratio-16x9 card-img-top bg-body-tertiary board-thumb">
                            <div>
                                @if (_loadedBoards.GetValueOrDefault(board.Id) is { } loadedBoard)
                                {
                                    <BoardSketch Board="loadedBoard" />
                                }
                            </div>
                        </div>
                        <div class="card-body d-flex align-items-start gap-2 py-2 pe-1">
                            <div class="flex-grow-1 board-card-text">
                                <a
                                    href="board/@board.Id"
                                    class="stretched-link link-body-emphasis fw-medium text-decoration-none d-block text-truncate"
                                    title="@board.Name"
                                >@board.Name</a>
                                <small class="text-body-secondary" title="@FullDate(board.UpdatedAt, now)">Edited @RelativeTime.Describe(board.UpdatedAt, now)</small>
                            </div>
                            <Dropdown
                                Class="board-card-menu"
                                ToggleClass="btn btn-link btn-sm link-secondary"
                                Label="@($"Actions for {board.Name}")"
                                Title="Actions"
                                Caret="false"
                                AlignEnd="true"
                            >
                                <Toggle><Icon Name="three-dots-vertical" /></Toggle>
                                <ChildContent Context="close">
                                    <button
                                        type="button"
                                        class="dropdown-item d-flex align-items-center gap-2"
                                        @onclick="() => { close(); StartRename(board); }"
                                    >
                                        <Icon Name="pencil" /> Rename…
                                    </button>
                                    <button
                                        type="button"
                                        class="dropdown-item d-flex align-items-center gap-2 text-danger"
                                        @onclick="() => { close(); StartDelete(board); }"
                                    >
                                        <Icon Name="trash" /> Delete…
                                    </button>
                                </ChildContent>
                            </Dropdown>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_renamingBoard is not null)
{
    <RenameBoardModal InitialName="@_renamingBoard.Name" OnSave="SaveRename" OnCancel="CancelRename" />
}

@if (_deletingBoard is not null)
{
    <DeleteBoardModal BoardName="@_deletingBoard.Name" OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />
}

<style>
    .board-card {
        transition: box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .board-card:hover {
        border-color: var(--bs-primary-border-subtle);
        box-shadow: var(--bs-box-shadow) !important;
    }

    .board-thumb {
        background-image: radial-gradient(var(--bs-border-color) 1px, transparent 1px);
        background-size: 12px 12px;
        border-bottom: var(--bs-border-width) solid var(--bs-border-color-translucent);
    }

    .board-card-text {
        min-width: 0;
    }

    .board-card-menu > .btn {
        position: relative;
        z-index: 2;
    }

    .board-new-tile {
        border: 2px dashed var(--bs-border-color);
        background: transparent;
        padding: 0;
    }

    .board-new-tile:hover:not(:disabled) {
        border-color: var(--bs-primary);
        color: var(--bs-primary) !important;
    }

    .board-empty {
        max-width: 480px;
    }
</style>

@code {
    private const string DefaultBoardName = "Untitled board";

    private List<BoardSummary>? _boards;
    private readonly Dictionary<Guid, Board?> _loadedBoards = [];
    private bool _isLoadingSketches;
    private bool _disposed;
    private bool _isCreating;
    private BoardSummary? _renamingBoard;
    private BoardSummary? _deletingBoard;

    protected override async Task OnInitializedAsync() => await RefreshBoards();

    protected override async Task OnAfterRenderAsync(bool firstRender) => await LoadMissingSketches();

    private async Task RefreshBoards()
    {
        var boards = await BoardStore.ListAsync();
        _boards = boards.OrderByDescending(b => b.UpdatedAt).ToList();
    }

    private async Task LoadMissingSketches()
    {
        if (_isLoadingSketches || _boards is null)
        {
            return;
        }

        _isLoadingSketches = true;
        try
        {
            while (!_disposed && _boards.FirstOrDefault(b => !_loadedBoards.ContainsKey(b.Id)) is { } board)
            {
                try
                {
                    _loadedBoards[board.Id] = (await BoardStore.LoadAsync(board.Id)).Board;
                }
                catch (BoardNotFoundException)
                {
                    _boards.Remove(board);
                }
                catch (Exception)
                {
                    _loadedBoards[board.Id] = null;
                }

                if (!_disposed)
                {
                    StateHasChanged();
                }
            }
        }
        finally
        {
            _isLoadingSketches = false;
        }
    }

    private static string FullDate(DateTimeOffset when, DateTimeOffset now) =>
        when.ToOffset(now.Offset).ToString("d MMMM yyyy 'at' HH:mm", CultureInfo.InvariantCulture);

    private async Task CreateBoard()
    {
        if (_isCreating)
        {
            return;
        }

        _isCreating = true;
        try
        {
            var saved = await BoardStore.CreateAsync(DefaultBoardName);
            Navigation.NavigateTo($"/board/{saved.Id}");
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void StartRename(BoardSummary board) => _renamingBoard = board;

    private void CancelRename() => _renamingBoard = null;

    private async Task SaveRename(string newName)
    {
        if (_renamingBoard is null)
        {
            return;
        }

        await BoardStore.RenameAsync(_renamingBoard.Id, newName);
        _renamingBoard = null;
        await RefreshBoards();
    }

    private void StartDelete(BoardSummary board) => _deletingBoard = board;

    private void CancelDelete() => _deletingBoard = null;

    private async Task ConfirmDelete()
    {
        if (_deletingBoard is null)
        {
            return;
        }

        var board = _deletingBoard;
        _deletingBoard = null;
        await BoardStore.DeleteAsync(board.Id);
        _boards?.Remove(board);
        _loadedBoards.Remove(board.Id);
    }

    public void Dispose() => _disposed = true;
}

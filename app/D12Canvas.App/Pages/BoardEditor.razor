@page "/board/{Id:guid}"
@implements IDisposable
@using D12Canvas
@using D12Canvas.App.Storage
@using D12Canvas.Model
@using D12Canvas.App.Preferences
@inject IBoardStore BoardStore
@inject IPreferences Preferences
@inject TimeProvider Clock

<AppPageTitle Page="@(_name ?? "Board")" />

@if (!_notFound)
{
    <SectionContent SectionName="@PageHeaderSections.Title">
        @if (_isEditingName)
        {
            <form class="board-title-form" @onsubmit="SubmitRenameTitle">
                <input
                    class="form-control form-control-sm"
                    aria-label="Board name"
                    @ref="_titleInputRef"
                    value="@_nameDraft"
                    @oninput="args => _nameDraft = args.Value?.ToString() ?? string.Empty"
                    @onkeydown="HandleTitleKeyDown"
                    @onblur="CommitRenameTitle"
                />
            </form>
        }
        else
        {
            <h1 class="board-title fs-5 fw-semibold mb-0 text-truncate" title="Click to rename" @onclick="StartRenameTitle">@_name</h1>
        }
        <button
            type="button"
            class="btn btn-link link-secondary btn-sm"
            aria-label="Rename board"
            title="Rename board"
            disabled="@(_board is null)"
            @ref="_renameButtonRef"
            @onmousedown:preventDefault="_isEditingName"
            @onclick="StartRenameTitle"
        >
            <Icon Name="pencil" />
        </button>
    </SectionContent>
    <SectionContent SectionName="@PageHeaderSections.More">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="History">
                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    aria-label="Undo"
                    title="Undo (Ctrl+Z)"
                    disabled="@(_canvas is null)"
                    @onclick="Undo"
                >
                    <Icon Name="arrow-counterclockwise" />
                </button>
                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    aria-label="Redo"
                    title="Redo (Ctrl+Shift+Z)"
                    disabled="@(_canvas is null)"
                    @onclick="Redo"
                >
                    <Icon Name="arrow-clockwise" />
                </button>
            </div>
            <Dropdown Label="View" Title="View" AlignEnd="true">
                <Toggle><Icon Name="sliders" /> <span class="d-none d-sm-inline">View</span></Toggle>
                <ChildContent Context="close">
                    <ZoomMenuItems Canvas="_canvas" Close="close" />
                    <hr class="dropdown-divider" />
                    <div class="px-3 py-1">
                        <div class="form-check form-switch mb-1" title="Snap to grid (Ctrl+')">
                            <input class="form-check-input" type="checkbox" role="switch" id="snap-to-grid" @bind="_snapToGrid" />
                            <label class="form-check-label text-nowrap" for="snap-to-grid">Snap to grid</label>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="object-snapping" @bind="_objectSnapping" />
                            <label class="form-check-label text-nowrap" for="object-snapping">Object snapping</label>
                        </div>
                    </div>
                    <hr class="dropdown-divider" />
                    <h6 class="dropdown-header">Mouse wheel</h6>
                    @foreach (var profile in WheelProfiles)
                    {
                        <button
                            type="button"
                            class="dropdown-item d-flex align-items-center gap-2"
                            aria-pressed="@Aria.Bool(profile == _wheelProfile)"
                            @onclick="() => { _wheelProfile = profile; close(); }"
                        >
                            <span class="d-flex @(profile == _wheelProfile ? null : "invisible")"><Icon Name="check2" /></span>
                            @profile
                        </button>
                    }
                </ChildContent>
            </Dropdown>
            <button
                type="button"
                class="btn btn-sm @(_showShortcuts ? "btn-secondary" : "btn-outline-secondary")"
                aria-label="Shortcuts"
                aria-pressed="@Aria.Bool(_showShortcuts)"
                title="Keyboard shortcuts"
                @onclick="ToggleShortcuts"
            >
                <Icon Name="keyboard" /> <span class="d-none d-lg-inline">Shortcuts</span>
            </button>
            <div class="d-flex align-items-center gap-3 ms-2">
                <span class="save-status small text-body-secondary d-flex align-items-center gap-1" role="status">
                    @if (_autosave.Status.Icon is { } statusIcon)
                    {
                        <Icon Name="@statusIcon" />
                    }
                    <span class="save-status-text">@_autosave.Status.Text</span>
                </span>
                @if (!_autosave.Enabled)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" disabled="@(!_autosave.IsDirty)" @onclick="Save">
                        <Icon Name="floppy" /> Save
                    </button>
                }
                <div class="form-check form-switch mb-0">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        role="switch"
                        id="autosave-switch"
                        checked="@_autosave.Enabled"
                        @onchange="SetAutosave"
                    />
                    <label class="form-check-label small" for="autosave-switch">Autosave</label>
                </div>
            </div>
        </div>
    </SectionContent>
}

<div class="board-editor-page">
    @if (_board is not null)
    {
        <div class="board-editor-body">
            <DiagramCanvas
                @ref="_canvas"
                Board="_board"
                @bind-SnapToGrid="_snapToGrid"
                @bind-ObjectSnapping="_objectSnapping"
                WheelDeviceProfile="_wheelProfile"
            />
            <div class="board-editor-overlay shadow-sm board-editor-palette">
                <Palette Canvas="_canvas" />
            </div>
            @if (_selectedCount > 0)
            {
                <div class="board-editor-overlay shadow-sm board-editor-properties">
                    <PropertyPanel Canvas="_canvas" />
                </div>
            }
            <div class="board-editor-overlay shadow-sm board-editor-minimap">
                <Minimap Canvas="_canvas" />
            </div>
            @if (_showShortcuts)
            {
                <div class="board-editor-overlay shadow-sm board-editor-shortcuts">
                    @foreach (var (heading, rows) in EditorShortcuts.Sections)
                    {
                        <h2>@heading</h2>
                        <dl>
                            @foreach (var (keys, action) in rows)
                            {
                                <dt>@keys</dt>
                                <dd>@action</dd>
                            }
                        </dl>
                    }
                </div>
            }
        </div>
        <footer class="board-editor-status-bar bg-body-tertiary border-top small text-body-secondary d-flex align-items-center gap-2 px-2">
            <span class="me-auto text-nowrap" role="status">@SelectionText</span>
            <button
                type="button"
                class="btn btn-link btn-sm status-bar-button status-bar-toggle d-none d-sm-flex align-items-center gap-1"
                aria-pressed="@Aria.Bool(_snapToGrid)"
                title="Snap to grid (Ctrl+')"
                @onclick="() => _snapToGrid = !_snapToGrid"
            >
                <Icon Name="grid-3x3-gap" /> Grid
            </button>
            <button
                type="button"
                class="btn btn-link btn-sm status-bar-button status-bar-toggle d-none d-sm-flex align-items-center gap-1"
                aria-pressed="@Aria.Bool(_objectSnapping)"
                title="Object snapping"
                @onclick="() => _objectSnapping = !_objectSnapping"
            >
                <Icon Name="magnet" /> Snapping
            </button>
            <ZoomControl Canvas="_canvas" />
        </footer>
    }
    else if (_notFound)
    {
        <p class="m-3" role="alert">No board found with that id.</p>
    }
</div>

<style>
    .board-editor-page {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .board-title {
        cursor: pointer;
    }

    .board-title-form {
        flex: 0 1 24rem;
    }

    .save-status {
        white-space: nowrap;
    }

    @@media (max-width: 575.98px) {
        .save-status-text {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
        }
    }

    .board-editor-status-bar {
        flex: none;
        height: 30px;
    }

    .status-bar-button {
        --bs-btn-padding-y: 0;
        --bs-btn-padding-x: 0.375rem;
        --bs-btn-font-size: inherit;
        text-decoration: none;
    }

    .status-bar-toggle[aria-pressed="true"] {
        --bs-btn-color: var(--bs-emphasis-color);
        --bs-btn-hover-color: var(--bs-emphasis-color);
        --bs-btn-active-color: var(--bs-emphasis-color);
    }

    .status-bar-toggle[aria-pressed="false"] {
        --bs-btn-color: var(--bs-secondary-color);
        --bs-btn-hover-color: var(--bs-body-color);
        --bs-btn-active-color: var(--bs-body-color);
        opacity: 0.6;
    }

    .zoom-level {
        min-width: 3.5rem;
        font-variant-numeric: tabular-nums;
    }

    .board-editor-body {
        flex: 1;
        min-height: 0;
        position: relative;
    }

    .board-editor-overlay {
        position: absolute;
        top: 12px;
        z-index: 10;
        max-height: calc(100% - 24px);
        overflow-y: auto;
    }

    .board-editor-palette {
        left: 12px;
        width: 180px;
        border-radius: 6px;
    }

    .board-editor-minimap {
        top: auto;
        bottom: 12px;
        right: 12px;
        width: 200px;
        height: 140px;
        overflow: hidden;
        border-radius: 6px;
    }

    .board-editor-properties {
        right: 12px;
        max-height: calc(100% - 176px);
        width: 260px;
        box-sizing: border-box;
        padding: 12px;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
    }
    .board-editor-shortcuts {
        left: 204px;
        width: 340px;
        box-sizing: border-box;
        padding: 12px 16px;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
        font-size: 0.85rem;
    }

    .board-editor-shortcuts h2 {
        margin: 10px 0 4px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--bs-secondary-color);
    }

    .board-editor-shortcuts h2:first-child {
        margin-top: 0;
    }

    .board-editor-shortcuts dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 2px 12px;
        margin: 0;
    }

    .board-editor-shortcuts dt {
        font-weight: 600;
        white-space: nowrap;
    }

    .board-editor-shortcuts dd {
        margin: 0;
    }
</style>

@code {
    private static readonly WheelDeviceProfile[] WheelProfiles = Enum.GetValues<WheelDeviceProfile>();

    [Parameter]
    public Guid Id { get; set; }

    private Board? _board;
    private string? _name;
    private bool _notFound;
    private DiagramCanvas? _canvas;
    private DiagramCanvas? _subscribedCanvas;
    private int _selectedCount;
    private bool _snapToGrid = true;
    private bool _objectSnapping = true;
    private bool _showShortcuts;
    private Autosave _autosave = null!;
    private WheelDeviceProfile _wheelProfile = WheelDeviceProfile.Auto;
    private bool _isEditingName;
    private string _nameDraft = "";
    private readonly PendingFocus _pendingFocus = new();
    private ElementReference _titleInputRef;
    private ElementReference _renameButtonRef;

    private string SelectionText =>
        _selectedCount == 0 ? "Nothing selected" : $"{_selectedCount} selected";

    protected override async Task OnInitializedAsync()
    {
        _autosave = new Autosave(Clock, () => BoardStore.SaveAsync(Id, _board!), InvokeAsync, StateHasChanged);
        _autosave.Enabled = await Preferences.GetAsync(PreferenceKeys.Autosave) != "false";

        try
        {
            var saved = await BoardStore.LoadAsync(Id);
            _board = saved.Board;
            _name = saved.Name;
        }
        catch (BoardNotFoundException)
        {
            _notFound = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _ = _pendingFocus.ApplyAsync();

        // DiagramCanvas is only rendered once _board finishes loading, so its @ref isn't captured
        // until a render after this page's own first one - re-checked on every render (cheap: a
        // reference comparison) rather than gated to firstRender, the same "subscribe once the
        // reference actually changes" shape PropertyPanel uses for its own Canvas parameter. @ref is
        // only assigned after the render that produced it, so Palette's own Canvas parameter is still
        // stale (null) on the render where _canvas is first captured (same wrinkle
        // PropertyPanelDemo's own layout documents) - the extra StateHasChanged forces the one more
        // render pass Palette needs to pick up the now-non-null reference.
        if (ReferenceEquals(_subscribedCanvas, _canvas))
        {
            return;
        }

        if (_subscribedCanvas is not null)
        {
            _subscribedCanvas.Changed -= HandleBoardChanged;
            _subscribedCanvas.SelectionChanged -= HandleSelectionChanged;
        }

        _subscribedCanvas = _canvas;

        if (_subscribedCanvas is not null)
        {
            _subscribedCanvas.Changed += HandleBoardChanged;
            _subscribedCanvas.SelectionChanged += HandleSelectionChanged;
        }

        StateHasChanged();
    }

    private void HandleSelectionChanged(object? sender, EventArgs e)
    {
        _selectedCount = (_canvas?.SelectedComponents.Count ?? 0) + (_canvas?.SelectedEdges.Count ?? 0);
        StateHasChanged();
    }

    private void Undo() => _canvas?.OnUndoPressed();

    private void Redo() => _canvas?.OnRedoPressed();

    private void ToggleShortcuts() => _showShortcuts = !_showShortcuts;

    private void HandleBoardChanged(object? sender, EventArgs e)
    {
        _autosave.BoardChanged();
        StateHasChanged();
    }

    private async Task SetAutosave(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        var applying = _autosave.SetEnabledAsync(enabled);
        await Preferences.SetAsync(PreferenceKeys.Autosave, enabled ? "true" : "false");
        await applying;
    }

    private Task Save() => _board is null ? Task.CompletedTask : _autosave.SaveAsync();

    private void StartRenameTitle()
    {
        if (_board is null)
        {
            return;
        }

        if (!_isEditingName)
        {
            _nameDraft = _name ?? "";
            _isEditingName = true;
        }

        _pendingFocus.Request(() => _titleInputRef);
    }

    private async Task CommitRenameTitle()
    {
        if (!_isEditingName)
        {
            return;
        }

        _isEditingName = false;
        var trimmed = _nameDraft.Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || trimmed == _name)
        {
            return;
        }

        _name = trimmed;
        await BoardStore.RenameAsync(Id, trimmed);
    }

    private void CancelRenameTitle()
    {
        _isEditingName = false;
        _nameDraft = _name ?? "";
    }

    private async Task SubmitRenameTitle()
    {
        ReturnFocusToRenameButton();
        await CommitRenameTitle();
    }

    private void HandleTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ReturnFocusToRenameButton();
            CancelRenameTitle();
        }
    }

    private void ReturnFocusToRenameButton() => _pendingFocus.Request(() => _renameButtonRef);

    public void Dispose()
    {
        _autosave?.Dispose();
        if (_subscribedCanvas is not null)
        {
            _subscribedCanvas.Changed -= HandleBoardChanged;
            _subscribedCanvas.SelectionChanged -= HandleSelectionChanged;
        }
    }
}
